  "diffs": {
    "Cargo.toml": "--- 09871abd0bc13a69b4318edad031287d8d4314d2/Cargo.toml\n+++ 95cca3f661f635b3cc85c04935fe8d96d8f432ef/Cargo.toml\n@@ -295,3 +295,8 @@\n \n [profile.dev]\n debug = 1\n+\n+# sciter-rs transmutes OR'ed flags into fieldless enums; rustc's debug-build\n+# enum check aborts on them (release builds never had the check).\n+[profile.dev.package.sciter-rs]\n+debug-assertions = false",
    "flutter/pubspec.yaml": "--- 09871abd0bc13a69b4318edad031287d8d4314d2/flutter/pubspec.yaml\n+++ 95cca3f661f635b3cc85c04935fe8d96d8f432ef/flutter/pubspec.yaml\n@@ -16,7 +16,7 @@\n # Read more about iOS versioning at\n # https://developer.apple.com/library/archive/documentation/General/Reference/InfoPlistKeyReference/Articles/CoreFoundationKeys.html\n # 1.1.9-1 works for android, but for ios it becomes 1.1.91, need to set it to 1.1.9-a.1 for iOS, will get 1.1.9.1, but iOS store not allow 4 numbers\n-version: 1.5.3+70\n+version: 1.5.3+71\n \n environment:\n   sdk: '^3.1.0'",
    ".github/workflows/flutter-build.yml": "--- 09871abd0bc13a69b4318edad031287d8d4314d2/.github/workflows/flutter-build.yml\n+++ 95cca3f661f635b3cc85c04935fe8d96d8f432ef/.github/workflows/flutter-build.yml\n@@ -1214,6 +1214,32 @@\n       # Required to inspect and publish signed release assets for the target tag.\n       contents: write\n     steps:\n+      - name: Refuse to replace published update metadata\n+        shell: bash\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n+          TAG_NAME: ${{ env.TAG_NAME }}\n+        run: |\n+          set -euo pipefail\n+          releases=\"$(gh api --paginate --slurp \"repos/${GITHUB_REPOSITORY}/releases?per_page=100\")\"\n+          release_id=\"$(\n+            jq -r --arg tag \"$TAG_NAME\" '\n+              [.[][] | select(.tag_name == $tag)] |\n+              if length == 0 then \"\"\n+              elif length == 1 then .[0].id\n+              else error(\"multiple releases found for tag\")\n+              end\n+            ' <<<\"$releases\"\n+          )\"\n+          if [ -z \"$release_id\" ]; then\n+            exit 0\n+          fi\n+          assets=\"$(gh api --paginate --slurp \"repos/${GITHUB_REPOSITORY}/releases/${release_id}/assets?per_page=100\")\"\n+          if jq -e 'any(.[][]; .name == \"rustdesk-update.json\")' <<<\"$assets\" >/dev/null; then\n+            echo \"::error::Signed update metadata is already published for ${TAG_NAME}; use a new release tag for corrected artifacts.\"\n+            exit 1\n+          fi\n+\n       - name: Checkout source code\n         uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4\n         with:"
