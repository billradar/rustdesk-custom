diff --git a/src/custom_update/mod.rs b/src/custom_update/mod.rs
new file mode 100644
index 0000000..1d1322f
--- /dev/null
+++ b/src/custom_update/mod.rs
@@ -0,0 +1,590 @@
+//! Custom Release updates: GitHub HTTPS/API integrity only.
+//! Independent update signatures are explicitly deferred; APK signatures remain unchanged.
+use hbb_common::{anyhow::anyhow, bail, ResultType};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::Mutex,
+    time::Duration,
+};
+mod policy;
+const REPOSITORY: &str = "billradar/rustdesk-custom";
+const API: &str = "https://api.github.com/repos/billradar/rustdesk-custom/releases/latest";
+pub const MANUAL_INSTALL_ONLY: bool = true;
+const MAX_ASSET: u64 = 1024 * 1024 * 1024;
+
+#[derive(Deserialize)]
+struct Build {
+    version: String,
+    revision: Option<String>,
+    upstream_sha: String,
+    variant: String,
+    build_run: String,
+}
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+struct Asset {
+    id: u64,
+    name: String,
+    size: u64,
+    digest: Option<String>,
+    browser_download_url: String,
+    state: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+struct Release {
+    id: u64,
+    tag_name: String,
+    draft: bool,
+    prerelease: bool,
+    html_url: String,
+    body: Option<String>,
+    assets: Vec<Asset>,
+}
+#[derive(Clone)]
+struct Candidate {
+    release: Release,
+    asset: Asset,
+}
+#[derive(Clone)]
+struct Downloaded {
+    candidate: Candidate,
+    path: PathBuf,
+}
+lazy_static::lazy_static! {
+    static ref CANDIDATE: Mutex<Option<Candidate>> = Mutex::new(None);
+    static ref DOWNLOADED: Mutex<Option<Downloaded>> = Mutex::new(None);
+    static ref OPERATION: Mutex<()> = Mutex::new(());
+}
+fn build() -> ResultType<Build> {
+    let b: Build = serde_json::from_str(include_str!("build.json"))?;
+    if policy::numeric::<3>(&b.version).is_none()
+        || !policy::hex(&b.upstream_sha, 40)
+        || !matches!(b.variant.as_str(), "standard" | "sos")
+        || b.build_run.parse::<u64>().is_err()
+        || b.revision
+            .as_ref()
+            .is_some_and(|r| policy::numeric::<2>(r.trim_start_matches('v')).is_none())
+    {
+        bail!("Custom update build identity unavailable; install a qualified build first");
+    }
+    Ok(b)
+}
+pub fn display_version() -> String {
+    match build() {
+        Ok(b) => match b.revision {
+            Some(r) => format!("{}-custom.{}", b.version, r),
+            None => format!("{}-custom.build{}", b.version, b.build_run),
+        },
+        Err(_) => crate::VERSION.to_owned(),
+    }
+}
+fn allowed_host(host: &str) -> bool {
+    host == "github.com" || host == "api.github.com" || host.ends_with(".githubusercontent.com")
+}
+fn client() -> ResultType<reqwest::blocking::Client> {
+    // No embedded token, insecure TLS exception, or official-server fallback.
+    Ok(reqwest::blocking::Client::builder()
+        .https_only(true)
+        .user_agent("rustdesk-custom-updater/1")
+        .connect_timeout(Duration::from_secs(15))
+        .timeout(Duration::from_secs(900))
+        .redirect(reqwest::redirect::Policy::custom(|attempt| {
+            if attempt.previous().len() >= 5
+                || attempt.url().scheme() != "https"
+                || !attempt.url().host_str().is_some_and(allowed_host)
+            {
+                attempt.error("Untrusted update redirect")
+            } else {
+                attempt.follow()
+            }
+        }))
+        .build()?)
+}
+fn get_release() -> ResultType<Release> {
+    let mut response = client()?
+        .get(API)
+        .timeout(Duration::from_secs(30))
+        .header("Accept", "application/vnd.github+json")
+        .send()?
+        .error_for_status()?;
+    let mut bytes = Vec::new();
+    response
+        .by_ref()
+        .take(4 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 4 * 1024 * 1024 {
+        bail!("Release response too large");
+    }
+    let r: Release = serde_json::from_slice(&bytes)?;
+    validate_release(&r)?;
+    Ok(r)
+}
+fn validate_release(r: &Release) -> ResultType<()> {
+    if r.draft
+        || r.prerelease
+        || policy::stable_tag(&r.tag_name).is_none()
+        || r.html_url
+            != format!(
+                "https://github.com/{REPOSITORY}/releases/tag/{}",
+                r.tag_name
+            )
+    {
+        bail!("Latest is not a published custom Stable release");
+    }
+    Ok(())
+}
+fn source(r: &Release) -> ResultType<String> {
+    // Only read the repository-owned metadata block, not upstream release prose.
+    let body = r.body.as_deref().unwrap_or("");
+    let marker = "<!-- rustdesk-custom-release-metadata\n";
+    if body.matches(marker).count() != 1 {
+        bail!("Release identity missing or duplicated");
+    }
+    let block = body
+        .split_once(marker)
+        .unwrap()
+        .1
+        .split_once("-->")
+        .ok_or_else(|| anyhow!("Release identity incomplete"))?
+        .0;
+    let states: Vec<_> = block
+        .lines()
+        .filter(|l| l.starts_with("automation_state="))
+        .collect();
+    if states.len() != 1
+        || !matches!(
+            states[0],
+            "automation_state=complete" | "automation_state=published"
+        )
+    {
+        bail!("Release assets are not qualified complete");
+    }
+    let values: Vec<_> = block
+        .lines()
+        .filter_map(|l| l.strip_prefix("Upstream SHA: "))
+        .collect();
+    if values.len() != 1 || !policy::hex(values[0], 40) {
+        bail!("Release source identity invalid");
+    }
+    Ok(values[0].to_owned())
+}
+fn package_format() -> ResultType<&'static str> {
+    #[cfg(target_os = "windows")]
+    {
+        return Ok(if crate::platform::is_msi_installed()? {
+            "msi"
+        } else {
+            "exe"
+        });
+    }
+    #[cfg(target_os = "macos")]
+    {
+        return Ok("dmg");
+    }
+    #[cfg(target_os = "android")]
+    {
+        return Ok("apk");
+    }
+    #[cfg(target_os = "linux")]
+    {
+        if cfg!(feature = "drm") {
+            return Ok("deb");
+        }
+        let installed = std::process::Command::new("dpkg-query")
+            .args(["-W", "-f=${Status}", "rustdesk"])
+            .output()
+            .is_ok_and(|o| o.status.success() && o.stdout == b"install ok installed");
+        if installed {
+            return Ok("deb");
+        }
+        if std::process::Command::new("rpm")
+            .args(["-q", "rustdesk"])
+            .output()
+            .is_ok_and(|o| o.status.success())
+        {
+            let os = fs::read_to_string("/etc/os-release")
+                .unwrap_or_default()
+                .to_lowercase();
+            return Ok(if os.contains("suse") {
+                "suse.rpm"
+            } else {
+                "rpm"
+            });
+        }
+        bail!("Package type unavailable; use the matching package on the Release page");
+    }
+    #[cfg(not(any(
+        target_os = "windows",
+        target_os = "macos",
+        target_os = "android",
+        target_os = "linux"
+    )))]
+    bail!("Updates are not supported on this platform");
+}
+fn selected_asset(r: &Release, b: &Build) -> ResultType<Asset> {
+    let arch = if cfg!(all(target_os = "android", target_arch = "arm")) {
+        "armv7"
+    } else {
+        std::env::consts::ARCH
+    };
+    asset_for(
+        r,
+        b,
+        std::env::consts::OS,
+        arch,
+        cfg!(all(target_os = "linux", feature = "drm")),
+        package_format()?,
+    )
+}
+fn asset_for(
+    r: &Release,
+    b: &Build,
+    platform: &str,
+    arch: &str,
+    wayland: bool,
+    format: &str,
+) -> ResultType<Asset> {
+    let (v, _) = policy::stable_tag(&r.tag_name).ok_or_else(|| anyhow!("Invalid Stable tag"))?;
+    let version = format!("{}.{}.{}", v[0], v[1], v[2]);
+    let name = policy::package_name(&version, &b.variant, platform, arch, wayland, format)
+        .ok_or_else(|| anyhow!("Unsupported package type"))?;
+    let assets: Vec<_> = r.assets.iter().filter(|a| a.name == name).collect();
+    if assets.len() != 1 {
+        bail!("Matching update package missing or duplicated");
+    }
+    let a = assets[0];
+    let digest = a.digest.as_deref().and_then(|d| d.strip_prefix("sha256:"));
+    if a.id == 0
+        || a.size == 0
+        || a.size > MAX_ASSET
+        || a.state != "uploaded"
+        || !digest.is_some_and(|d| policy::hex(d, 64))
+        || a.browser_download_url
+            != format!(
+                "https://github.com/{REPOSITORY}/releases/download/{}/{}",
+                r.tag_name, name
+            )
+    {
+        bail!("Update package digest, size or URL invalid");
+    }
+    Ok(a.clone())
+}
+fn clear() {
+    *CANDIDATE.lock().unwrap() = None;
+    *super::SOFTWARE_UPDATE_URL.lock().unwrap() = String::new();
+}
+pub fn check() -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    clear();
+    let b = build()?;
+    let r = get_release()?;
+    let (version, revision) = policy::stable_tag(&r.tag_name).unwrap();
+    let installed_revision = b
+        .revision
+        .as_deref()
+        .and_then(|v| policy::numeric::<2>(v.trim_start_matches('v')));
+    if !policy::newer(
+        policy::numeric(&b.version).unwrap(),
+        installed_revision,
+        &b.upstream_sha,
+        version,
+        revision,
+        &source(&r)?,
+    ) {
+        return Ok(json!({"status":"current","current":display_version()}));
+    }
+    let asset = selected_asset(&r, &b)?;
+    *CANDIDATE.lock().unwrap() = Some(Candidate {
+        release: r.clone(),
+        asset,
+    });
+    *super::SOFTWARE_UPDATE_URL.lock().unwrap() = r.html_url.clone();
+    #[cfg(feature = "flutter")]
+    {
+        let event = json!({"name":"check_software_update_finish","url":r.html_url}).to_string();
+        let _ = crate::flutter::push_global_event(crate::flutter::APP_TYPE_MAIN, event);
+    }
+    Ok(
+        json!({"status":"available","version":r.tag_name,"url":r.html_url,"current":display_version()}),
+    )
+}
+fn verify_file(path: &Path, a: &Asset) -> ResultType<()> {
+    let meta = fs::symlink_metadata(path)?;
+    if !meta.is_file() || meta.len() != a.size {
+        bail!("Update size mismatch");
+    }
+    let mut file = fs::File::open(path)?;
+    let mut digest = Sha256::new();
+    let mut buf = [0u8; 65536];
+    loop {
+        let n = file.read(&mut buf)?;
+        if n == 0 {
+            break;
+        }
+        digest.update(&buf[..n]);
+    }
+    if a.digest.as_deref() != Some(format!("sha256:{:x}", digest.finalize()).as_str()) {
+        bail!("Update SHA256 mismatch");
+    }
+    Ok(())
+}
+fn download(request: &str) -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    let req: Value = serde_json::from_str(request)?;
+    let c = CANDIDATE
+        .lock()
+        .unwrap()
+        .clone()
+        .ok_or_else(|| anyhow!("Check for updates first"))?;
+    if req["release"].as_u64() != Some(c.release.id) || req["asset"].as_u64() != Some(c.asset.id) {
+        bail!("Update selection expired; check again");
+    }
+    // Revalidate latest immediately before download. Closed/replaced Releases fail closed.
+    let r = get_release()?;
+    if r.id != c.release.id
+        || r.tag_name != c.release.tag_name
+        || source(&r)? != source(&c.release)?
+        || selected_asset(&r, &build()?)? != c.asset
+    {
+        clear();
+        bail!("Release changed; check again");
+    }
+    let directory = PathBuf::from(
+        req["directory"]
+            .as_str()
+            .ok_or_else(|| anyhow!("Download directory missing"))?,
+    );
+    if !directory.is_absolute() || !directory.is_dir() {
+        bail!("Invalid download directory");
+    }
+    let parent = directory.join("custom-updates");
+    let mut builder = fs::DirBuilder::new();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    match builder.create(&parent) {
+        Ok(()) => (),
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => (),
+        Err(e) => return Err(e.into()),
+    }
+    let metadata = fs::symlink_metadata(&parent)?;
+    if !metadata.is_dir() {
+        bail!("Unsafe update directory");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { hbb_common::libc::geteuid() } || metadata.mode() & 0o077 != 0
+        {
+            bail!("Update directory must be private and owned by the current user");
+        }
+    }
+    let nonce = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)?
+        .as_nanos();
+    let folder = parent.join(format!("{}-{nonce}", std::process::id()));
+    builder.create(&folder)?;
+    let path = folder.join(&c.asset.name);
+    let result = (|| -> ResultType<()> {
+        let mut response = client()?
+            .get(&c.asset.browser_download_url)
+            .send()?
+            .error_for_status()?;
+        if response.content_length().is_some_and(|n| n != c.asset.size) {
+            bail!("Update content length mismatch");
+        }
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)?;
+        let copied = std::io::copy(&mut response.by_ref().take(c.asset.size + 1), &mut file)?;
+        file.flush()?;
+        file.sync_all()?;
+        drop(file);
+        if copied != c.asset.size {
+            bail!("Update download truncated or oversized");
+        }
+        verify_file(&path, &c.asset)
+    })();
+    if let Err(e) = result {
+        let _ = fs::remove_file(&path);
+        let _ = fs::remove_dir(&folder);
+        return Err(e);
+    }
+    *DOWNLOADED.lock().unwrap() = Some(Downloaded {
+        candidate: c,
+        path: path.clone(),
+    });
+    Ok(json!({"path":path,"status":"downloaded"}))
+}
+fn open_download() -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    let d = DOWNLOADED
+        .lock()
+        .unwrap()
+        .clone()
+        .ok_or_else(|| anyhow!("No verified update downloaded"))?;
+    verify_file(&d.path, &d.candidate.asset)?;
+    #[cfg(target_os = "windows")]
+    {
+        if d.path.extension().and_then(|s| s.to_str()) == Some("msi") {
+            std::process::Command::new("msiexec.exe")
+                .arg("/i")
+                .arg(&d.path)
+                .spawn()?;
+        } else {
+            std::process::Command::new(&d.path).spawn()?;
+        }
+    }
+    #[cfg(target_os = "macos")]
+    {
+        std::process::Command::new("open").arg(&d.path).spawn()?;
+    }
+    #[cfg(target_os = "linux")]
+    {
+        std::process::Command::new("xdg-open")
+            .arg(&d.path)
+            .spawn()?;
+    }
+    // Android hands the verified private-cache APK to its system installer via FileProvider.
+    Ok(json!({"status":"opened","path":d.path}))
+}
+pub fn response(key: &str) -> Option<String> {
+    if !key.starts_with("custom-update-") {
+        return None;
+    }
+    let result = if key == "custom-update-check" {
+        check()
+    } else if key == "custom-update-info" {
+        Ok(match CANDIDATE.lock().unwrap().as_ref() {
+            Some(c) => {
+                json!({"status":"available","version":c.release.tag_name,"url":c.release.html_url,
+                "release":c.release.id,"asset":c.asset.id,"size":c.asset.size,"current":display_version()})
+            }
+            None => json!({"status":"current","current":display_version()}),
+        })
+    } else if let Some(request) = key.strip_prefix("custom-update-download:") {
+        download(request)
+    } else if key == "custom-update-open" {
+        open_download()
+    } else {
+        Err(anyhow!("Unsupported custom update request"))
+    };
+    Some(match result {
+        Ok(v) => v.to_string(),
+        Err(e) => json!({"status":"unavailable","error":e.to_string()}).to_string(),
+    })
+}
+pub fn new_version() -> String {
+    CANDIDATE
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|c| c.release.tag_name.clone())
+        .unwrap_or_default()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn release() -> Release {
+        let tag = "v1.5.1-custom.v2.6";
+        Release { id:1,tag_name:tag.into(),draft:false,prerelease:false,
+            html_url:format!("https://github.com/{REPOSITORY}/releases/tag/{tag}"),
+            body:Some(format!("<!-- rustdesk-custom-release-metadata\nUpstream SHA: {}\nautomation_state=complete\n-->\n","a".repeat(40))),
+            assets:vec![Asset { id:2,name:"rustdesk-1.5.1-linux-x86_64.deb".into(),size:4,
+                digest:Some(format!("sha256:{:x}",Sha256::digest(b"test"))),state:"uploaded".into(),
+                browser_download_url:format!("https://github.com/{REPOSITORY}/releases/download/{tag}/rustdesk-1.5.1-linux-x86_64.deb") }] }
+    }
+    fn identity() -> Build {
+        Build {
+            version: "1.5.1".into(),
+            revision: Some("v2.5".into()),
+            upstream_sha: "a".repeat(40),
+            variant: "standard".into(),
+            build_run: "1".into(),
+        }
+    }
+    #[test]
+    fn reject_nonstable_and_foreign_releases() {
+        let mut r = release();
+        assert!(validate_release(&r).is_ok());
+        r.draft = true;
+        assert!(validate_release(&r).is_err());
+        r.draft = false;
+        r.prerelease = true;
+        assert!(validate_release(&r).is_err());
+        r.prerelease = false;
+        r.tag_name = "nightly".into();
+        assert!(validate_release(&r).is_err());
+        r = release();
+        r.html_url = r.html_url.replace(REPOSITORY, "other/repo");
+        assert!(validate_release(&r).is_err());
+    }
+    #[test]
+    fn fail_closed_on_metadata_drift() {
+        let mut r = release();
+        assert_eq!(source(&r).unwrap(), "a".repeat(40));
+        r.body = Some(r.body.clone().unwrap().replace("complete", "uploading"));
+        assert!(source(&r).is_err());
+        r = release();
+        r.body = Some(r.body.clone().unwrap().replace(
+            "automation_state=complete",
+            "automation_state=complete\nautomation_state=uploading",
+        ));
+        assert!(source(&r).is_err());
+        r = release();
+        r.body = Some(r.body.clone().unwrap().repeat(2));
+        assert!(source(&r).is_err());
+    }
+    #[test]
+    fn exact_asset_requires_api_digest_size_and_owner() {
+        let b = identity();
+        let good = release();
+        assert!(asset_for(&good, &b, "linux", "x86_64", false, "deb").is_ok());
+        assert!(asset_for(&good, &b, "linux", "x86_64", true, "deb").is_err());
+        assert!(asset_for(&good, &b, "linux", "aarch64", false, "deb").is_err());
+        let mut r = good.clone();
+        r.assets[0].digest = None;
+        assert!(asset_for(&r, &b, "linux", "x86_64", false, "deb").is_err());
+        r = good.clone();
+        r.assets[0].size = 0;
+        assert!(asset_for(&r, &b, "linux", "x86_64", false, "deb").is_err());
+        r = good.clone();
+        r.assets[0].browser_download_url = r.assets[0]
+            .browser_download_url
+            .replace(REPOSITORY, "other/repo");
+        assert!(asset_for(&r, &b, "linux", "x86_64", false, "deb").is_err());
+        r = good;
+        r.assets.push(r.assets[0].clone());
+        assert!(asset_for(&r, &b, "linux", "x86_64", false, "deb").is_err());
+    }
+    #[test]
+    fn verify_content_not_just_size() {
+        let folder =
+            std::env::temp_dir().join(format!("custom-update-test-{}", std::process::id()));
+        fs::create_dir(&folder).unwrap();
+        let path = folder.join("asset");
+        let a = release().assets.remove(0);
+        fs::write(&path, b"test").unwrap();
+        assert!(verify_file(&path, &a).is_ok());
+        fs::write(&path, b"evil").unwrap();
+        assert!(verify_file(&path, &a).is_err());
+        fs::write(&path, b"shorter").unwrap();
+        assert!(verify_file(&path, &a).is_err());
+        fs::remove_file(path).unwrap();
+        fs::remove_dir(folder).unwrap();
+    }
+    #[test]
+    fn only_known_https_redirect_hosts() {
+        assert!(allowed_host("release-assets.githubusercontent.com"));
+        assert!(!allowed_host("github.com.evil.test"));
+        assert!(!allowed_host("githubusercontent.com.evil.test"));
+    }
+}
