@@ -0,0 +1,156 @@
+//! Release policy shared by both supported patch generations.
+pub fn numeric<const N: usize>(value: &str) -> Option<[u64; N]> {
+    let parts: Vec<_> = value.split('.').collect();
+    if parts.len() != N {
+        return None;
+    }
+    let mut result = [0; N];
+    for (i, part) in parts.iter().enumerate() {
+        if part.is_empty() || !part.bytes().all(|c| c.is_ascii_digit()) {
+            return None;
+        }
+        result[i] = part.parse().ok()?;
+    }
+    Some(result)
+}
+pub fn stable_tag(tag: &str) -> Option<([u64; 3], [u64; 2])> {
+    let (version, revision) = tag.strip_prefix('v')?.split_once("-custom.v")?;
+    let revision: [u64; 2] = numeric(revision)?;
+    if revision.contains(&0) {
+        return None;
+    }
+    Some((numeric(version)?, revision))
+}
+pub fn newer(
+    current: [u64; 3],
+    revision: Option<[u64; 2]>,
+    source: &str,
+    remote: [u64; 3],
+    remote_revision: [u64; 2],
+    remote_source: &str,
+) -> bool {
+    if current != remote {
+        return remote > current;
+    }
+    match revision {
+        Some(local) => remote_revision > local,
+        // Non-release builds may move to Stable at the same version only when
+        // the exact upstream source agrees. Never guess Nightly chronology.
+        None => source == remote_source,
+    }
+}
+pub fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+pub fn package_name(
+    version: &str,
+    variant: &str,
+    platform: &str,
+    arch: &str,
+    wayland: bool,
+    format: &str,
+) -> Option<String> {
+    numeric::<3>(version)?;
+    if !matches!(variant, "standard" | "sos") || !matches!(arch, "x86_64" | "aarch64" | "armv7") {
+        return None;
+    }
+    let suffix = if variant == "sos" { "-sos" } else { "" };
+    if wayland {
+        if platform != "linux" || format != "deb" || arch == "armv7" {
+            return None;
+        }
+        return Some(format!(
+            "rustdesk-unattended-wayland-{variant}-{version}-{arch}.deb"
+        ));
+    }
+    let name = match (platform, format) {
+        ("windows", "exe" | "msi") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-windows-{arch}.{format}")
+        }
+        ("macos", "dmg") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-macos-{arch}-unsigned.dmg")
+        }
+        ("linux", "deb") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-linux-{arch}.deb")
+        }
+        ("linux", "rpm" | "suse.rpm") if arch != "armv7" => {
+            let rpm_arch = if arch == "aarch64" {
+                "aarch64"
+            } else {
+                "x86_64"
+            };
+            let tail = if format == "suse.rpm" {
+                "-suse.rpm"
+            } else {
+                ".rpm"
+            };
+            format!("rustdesk-{version}{suffix}-linux-{arch}-0.{rpm_arch}{tail}")
+        }
+        ("android", "apk") if variant == "standard" => {
+            format!("rustdesk-{version}-android-{arch}-signed.apk")
+        }
+        _ => return None,
+    };
+    Some(name)
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn numeric_revisions() {
+        assert!(
+            stable_tag("v1.5.1-custom.v2.10").unwrap().1
+                > stable_tag("v1.5.1-custom.v2.9").unwrap().1
+        );
+        for s in [
+            "nightly",
+            "v1.5-custom.v2.5",
+            "v1.5.1-custom.v2.0",
+            "v1.5.1-custom.v2.5/evil",
+            "v1.5.1-custom.v2.18446744073709551616",
+        ] {
+            assert!(stable_tag(s).is_none());
+        }
+    }
+    #[test]
+    fn revision_upgrade_without_downgrade() {
+        assert!(newer([1, 5, 1], Some([2, 5]), "a", [1, 5, 1], [2, 6], "b"));
+        assert!(!newer([1, 5, 1], Some([2, 6]), "a", [1, 5, 1], [2, 5], "b"));
+        assert!(!newer(
+            [1, 5, 1],
+            Some([2, 5]),
+            "a",
+            [1, 5, 0],
+            [99, 99],
+            "b"
+        ));
+        assert!(newer([1, 5, 1], Some([2, 5]), "a", [1, 5, 2], [2, 1], "b"));
+        assert!(!newer([1, 5, 1], Some([2, 5]), "a", [1, 5, 1], [2, 5], "b"));
+    }
+    #[test]
+    fn non_release_waits_for_stable_to_catch_up() {
+        assert!(!newer([1, 5, 1], None, "a", [1, 5, 1], [2, 6], "b"));
+        assert!(newer([1, 5, 1], None, "a", [1, 5, 1], [2, 6], "a"));
+        assert!(newer([1, 5, 1], None, "a", [1, 5, 2], [2, 6], "b"));
+    }
+    #[test]
+    fn exact_package_types() {
+        assert_eq!(
+            package_name("1.5.1", "standard", "linux", "x86_64", true, "deb").unwrap(),
+            "rustdesk-unattended-wayland-standard-1.5.1-x86_64.deb"
+        );
+        assert_eq!(
+            package_name("1.5.1", "sos", "windows", "aarch64", false, "msi").unwrap(),
+            "rustdesk-1.5.1-sos-windows-aarch64.msi"
+        );
+        assert_eq!(
+            package_name("1.5.1", "standard", "android", "armv7", false, "apk").unwrap(),
+            "rustdesk-1.5.1-android-armv7-signed.apk"
+        );
+        assert!(package_name("1.5.1", "sos", "android", "aarch64", false, "apk").is_none());
+        assert!(package_name("1.5.1", "standard", "windows", "x86_64", true, "exe").is_none());
+    }
+}
