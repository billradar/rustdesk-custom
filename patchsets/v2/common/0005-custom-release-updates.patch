new file mode 100644
index 0000000..8dfd52e
--- /dev/null
+++ b/flutter/lib/common/widgets/custom_update.dart
@@ -0,0 +1,154 @@
+import 'dart:convert';
+import 'package:flutter/material.dart';
+import 'package:path_provider/path_provider.dart';
+import 'package:url_launcher/url_launcher.dart';
+import '../../common.dart';
+import '../../models/platform_model.dart';
+
+const useCustomReleaseUpdates = true;
+
+Future<Map<String, dynamic>> _request(String key) async {
+  final value = jsonDecode(await bind.mainGetCommon(key: key));
+  if (value is! Map<String, dynamic>) {
+    throw StateError('Invalid update response');
+  }
+  return value;
+}
+
+class CustomUpdateSettings extends StatelessWidget {
+  const CustomUpdateSettings({super.key});
+  @override
+  Widget build(BuildContext context) => ListTile(
+        title: Text(translate('Check for updates')),
+        subtitle: FutureBuilder<String>(
+            future: bind.mainGetVersion(),
+            builder: (context, snapshot) => Text(snapshot.data ?? '')),
+        trailing: const Icon(Icons.system_update),
+        onTap: () => showCustomUpdateDialog(),
+      );
+}
+
+Future<void> showCustomUpdateDialog() async {
+  final context = globalKey.currentContext;
+  if (context == null) return;
+  await showDialog<void>(
+      context: context, builder: (_) => const _CustomUpdateDialog());
+}
+
+class _CustomUpdateDialog extends StatefulWidget {
+  const _CustomUpdateDialog();
+  @override
+  State<_CustomUpdateDialog> createState() => _CustomUpdateDialogState();
+}
+
+class _CustomUpdateDialogState extends State<_CustomUpdateDialog> {
+  bool _busy = false;
+  Map<String, dynamic> _info = {};
+  String _message = '';
+  bool _downloaded = false;
+  @override
+  void initState() {
+    super.initState();
+    _check();
+  }
+
+  Future<void> _check() async {
+    setState(() {
+      _busy = true;
+      _downloaded = false;
+      _message = '';
+      _info = {};
+    });
+    try {
+      final result = await _request('custom-update-check');
+      if (!mounted) return;
+      _info = result['status'] == 'available'
+          ? await _request('custom-update-info')
+          : result;
+      _message = _info['status'] == 'available'
+          ? '${_info['version']}'
+          : translate(_info['status'] == 'current'
+              ? 'No newer compatible release'
+              : 'Update temporarily unavailable');
+    } catch (_) {
+      _message = translate('Update temporarily unavailable');
+    }
+    if (mounted) setState(() => _busy = false);
+  }
+
+  Future<void> _download() async {
+    setState(() {
+      _busy = true;
+      _message = translate('Downloading and verifying update');
+    });
+    try {
+      final directory = await getTemporaryDirectory();
+      final result = await _request('custom-update-download:${jsonEncode({
+            'directory': directory.path,
+            'release': _info['release'],
+            'asset': _info['asset']
+          })}');
+      if (!mounted) return;
+      _downloaded = result['status'] == 'downloaded';
+      _message = translate(_downloaded
+          ? 'Update download verified'
+          : 'Update temporarily unavailable');
+    } catch (_) {
+      _message = translate('Update temporarily unavailable');
+    }
+    if (mounted) setState(() => _busy = false);
+  }
+
+  Future<void> _install() async {
+    setState(() => _busy = true);
+    try {
+      final result = await _request('custom-update-open');
+      if (result['status'] != 'opened') {
+        throw StateError('Update verification failed');
+      }
+      if (isAndroid) {
+        final opened =
+            await gFFI.invokeMethod('custom_update_install', result['path']);
+        if (opened != true) throw StateError('Installer permission required');
+      }
+      _message = translate('Complete installation in the system installer');
+    } catch (_) {
+      _message =
+          translate('Unable to open installer; check installation permissions');
+    }
+    if (mounted) setState(() => _busy = false);
+  }
+
+  @override
+  Widget build(BuildContext context) => AlertDialog(
+        title: Text(translate('Check for updates')),
+        content: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              if (_busy) const LinearProgressIndicator(),
+              const SizedBox(height: 12),
+              Text(_message),
+            ]),
+        actions: [
+          TextButton(
+              onPressed: _busy ? null : _check,
+              child: Text(translate('Retry'))),
+          if (_info['status'] == 'available' && !_downloaded)
+            TextButton(
+                onPressed: _busy ? null : _download,
+                child: Text(translate('Download'))),
+          if (_downloaded)
+            TextButton(
+                onPressed: _busy ? null : _install,
+                child: Text(translate('Install'))),
+          if (_info['url'] is String)
+            TextButton(
+                onPressed: () => launchUrl(Uri.parse(_info['url'] as String)),
+                child: Text(translate('Changelog'))),
+          TextButton(
+              onPressed: () => Navigator.of(context).pop(),
+              child: Text(translate('Close'))),
+        ],
+      );
+}
