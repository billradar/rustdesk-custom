+// Preserve the legacy custom-client defaults; password security redesign is deferred.
+fn apply_custom_build_defaults() {
+    {
+        let mut hard_settings = config::HARD_SETTINGS.write().unwrap();
+        hard_settings.insert("password".to_owned(), env!("RUSTDESK_PASSWORD").to_owned());
+        hard_settings.insert("verification-method".to_owned(), "use-permanent-password".to_owned());
+    }
+    {
+        let mut defaults = config::DEFAULT_SETTINGS.write().unwrap();
+        defaults
+            .entry(base::config::keys::OPTION_ALLOW_REMOTE_CONFIG_MODIFICATION.to_owned())
+            .or_insert("Y".to_owned());
+        defaults.entry("allow-hide-cm".to_owned()).or_insert("Y".to_owned());
+        // Empty means upstream's normal relay discovery, matching the old clients.
+        if let Some(relay) = option_env!("RUSTDESK_RELAY_SERVER").filter(|s| !s.is_empty()) {
+            defaults.entry("relay-server".to_owned()).or_insert(relay.to_owned());
+        }
+    }
+}
