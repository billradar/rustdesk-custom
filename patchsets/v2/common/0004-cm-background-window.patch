--- /dev/null
+++ b/flutter/lib/models/cm_window_policy.dart
@@ -0,0 +1,24 @@
+/// Visibility policy for the CM isolate only. Unknown startup state stays hidden.
+class CmWindowPolicy {
+  bool ready = false;
+  bool background = true;
+  bool manualRequested = false;
+  bool visible = false;
+
+  bool get allowAutomaticShow => ready && !background;
+
+  void configure(bool hide) {
+    background = hide;
+    ready = true;
+  }
+
+  bool requestShow({bool manual = false}) {
+    if (manual) manualRequested = true;
+    return ready && (manual || allowAutomaticShow);
+  }
+
+  void hide() {
+    manualRequested = false;
+    visible = false;
+  }
+}
