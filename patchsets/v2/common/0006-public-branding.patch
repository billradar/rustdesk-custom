diff --git a/flutter/lib/common/branding.dart b/flutter/lib/common/branding.dart
new file mode 100644
index 0000000..350ebcf
--- /dev/null
+++ b/flutter/lib/common/branding.dart
@@ -0,0 +1,83 @@
+import 'dart:ui' show PlatformDispatcher;
+import 'package:flutter/material.dart';
+import 'package:url_launcher/url_launcher_string.dart';
+import '../common.dart';
+import '../models/platform_model.dart';
+import 'branding_values.dart';
+import 'custom_about_identity.dart';
+
+bool brandingUsesChinese() {
+  var language = bind.mainGetLocalOption(key: 'lang');
+  if (language.isEmpty || language == 'default') {
+    language = PlatformDispatcher.instance.locale.toString();
+  }
+  language = language.toLowerCase().replaceAll('_', '-');
+  return language.startsWith('zh') && !language.contains('tw');
+}
+
+String brandingText(String key, String fallback) {
+  final suffix = brandingUsesChinese() ? '_ZH_CN' : '_EN';
+  return customBranding['$key$suffix'] ?? customBranding[key] ?? fallback;
+}
+
+String brandingVersion(String upstream) =>
+    customAboutVersion.isEmpty ? upstream : customAboutVersion;
+
+String brandingLink(String key, String fallback) =>
+    customBranding[key] ?? fallback;
+
+String brandingWindowTitle(String original) {
+  final name = brandingText('CUSTOM_DISPLAY_NAME', '');
+  return name.isEmpty ? original : original.replaceFirst('RustDesk', name);
+}
+
+String brandingVariantLabel(String variant, bool wayland, bool chinese) {
+  final name = chinese
+      ? (variant == 'Standard' ? '标准版' : variant == 'SOS' ? 'SOS 远程协助版' : variant)
+      : variant;
+  final flavor = wayland
+      ? (chinese ? ' + Wayland 无人值守' : ' + Wayland unattended')
+      : '';
+  return '${chinese ? "变体" : "Variant"}: $name$flavor';
+}
+
+List<Widget> brandingAboutDetails() {
+  final widgets = <Widget>[
+    if (customAboutVariant.isNotEmpty)
+      Text(brandingVariantLabel(customAboutVariant, customAboutWayland,
+          brandingUsesChinese())),
+  ];
+  for (final key in [
+    'CUSTOM_DESCRIPTION',
+    'CUSTOM_CUSTOMIZATION_NOTICE',
+    'CUSTOM_MAINTAINER',
+    'CUSTOM_CONTACT_EMAIL'
+  ]) {
+    final text = brandingText(key, '');
+    if (text.isNotEmpty) {
+      widgets.add(ConstrainedBox(
+          constraints: const BoxConstraints(maxWidth: 360), child: Text(text)));
+    }
+  }
+  for (final entry in {
+    'CUSTOM_HELP_URL': 'Help',
+    'CUSTOM_SUPPORT_URL': 'Feedback'
+  }.entries) {
+    final url = brandingLink(entry.key, '');
+    if (url.isNotEmpty) {
+      widgets.add(TextButton(
+          onPressed: () => launchUrlString(url),
+          child: Text(translate(entry.value))));
+    }
+  }
+  return widgets;
+}
+
+List<Widget> brandingInstallerHeading({TextStyle? style}) {
+  final description = brandingText('CUSTOM_INSTALLER_DESCRIPTION', '');
+  return [
+    Text(brandingText('CUSTOM_INSTALLER_TITLE', translate('Installation')),
+        style: style),
+    if (description.isNotEmpty) Text(description),
+  ];
+}
