+//! WSS primary/fallback handshake policy for the verified own RustDesk endpoint.
+//! This module deliberately has no shared HTTP API state.
+use crate::{
+    config::{keys::OPTION_WEBSOCKET_PORT, use_ws, Config},
+    socket_client::split_host_port,
+};
+use std::io::{self, ErrorKind};
+
+include!("radar_wss_generated.rs");
+
+fn origins() -> Option<(url::Url, url::Url)> {
+    let primary = url::Url::parse(PROFILE_PRIMARY).ok()?;
+    let fallback = url::Url::parse(PROFILE_FALLBACK).ok()?;
+    if primary.scheme() != "https"
+        || fallback.scheme() != "https"
+        || primary.domain().is_none()
+        || fallback.domain().is_none()
+        || primary.domain() == fallback.domain()
+        || primary.port_or_known_default() != Some(443)
+        || fallback.port_or_known_default() != Some(443)
+        || primary.path() != "/"
+        || fallback.path() != "/"
+        || primary.username() != ""
+        || fallback.username() != ""
+        || primary.password().is_some()
+        || fallback.password().is_some()
+        || primary.query().is_some()
+        || fallback.query().is_some()
+        || primary.fragment().is_some()
+        || fallback.fragment().is_some()
+    {
+        return None;
+    }
+    Some((primary, fallback))
+}
+
+fn own_primary_host(host: &str) -> bool {
+    let Some((primary, _)) = origins() else {
+        return false;
+    };
+    let Some(primary_domain) = primary.domain() else {
+        return false;
+    };
+    if !host.trim_end_matches('.').eq_ignore_ascii_case(primary_domain) {
+        return false;
+    }
+    let configured = Config::get_rendezvous_server();
+    let configured_host = split_host_port(&configured)
+        .map(|(name, _)| name)
+        .unwrap_or(configured);
+    configured_host
+        .trim_end_matches('.')
+        .eq_ignore_ascii_case(primary_domain)
+}
+
+pub(super) fn prefer_wss(host: &str) -> bool {
+    Config::get_option("api-server").is_empty() && own_primary_host(host)
+}
+
+fn managed_config() -> bool {
+    use_ws()
+        && Config::get_option("api-server").is_empty()
+        && Config::get_option(OPTION_WEBSOCKET_PORT).is_empty()
+}
+
+fn valid_ws_url(candidate: &url::Url) -> bool {
+    candidate.scheme() == "wss"
+        && candidate.port_or_known_default() == Some(443)
+        && matches!(candidate.path(), "/ws/id" | "/ws/relay")
+        && candidate.username().is_empty()
+        && candidate.password().is_none()
+        && candidate.query().is_none()
+        && candidate.fragment().is_none()
+}
+
+pub(super) fn fallback_url(url: &str) -> Option<String> {
+    if !managed_config() {
+        return None;
+    }
+    let (primary, fallback) = origins()?;
+    let current = url::Url::parse(url).ok()?;
+    if !valid_ws_url(&current) {
+        return None;
+    }
+    let primary_domain = primary.domain()?;
+    if current.domain()? != primary_domain || !own_primary_host(primary_domain) {
+        return None;
+    }
+    // Only an unqualified own ID host and own same-host relay can reach this
+    // path through check_ws(). Never redirect an unrelated relay host.
+    Some(format!("wss://{}{}", fallback.domain()?, current.path()))
+}
+
+pub(super) fn strict_managed_url(url: &str) -> bool {
+    if !managed_config() {
+        return false;
+    }
+    let Some((primary, fallback)) = origins() else {
+        return false;
+    };
+    let Ok(candidate) = url::Url::parse(url) else {
+        return false;
+    };
+    if !valid_ws_url(&candidate) {
+        return false;
+    }
+    let Some(primary_domain) = primary.domain() else {
+        return false;
+    };
+    own_primary_host(primary_domain)
+        && matches!(candidate.domain(), Some(host) if host == primary_domain || Some(host) == fallback.domain())
+}
+
+fn retryable_io_kind(kind: ErrorKind, direct: bool) -> bool {
+    // Name-resolution failures commonly surface as ErrorKind::Other.
+    // Only direct sockets may use that broad IO class; an explicit proxy
+    // can report authentication/configuration errors in the same class.
+    (direct && kind == ErrorKind::Other)
+        || matches!(
+        kind,
+        ErrorKind::ConnectionRefused
+            | ErrorKind::ConnectionAborted
+            | ErrorKind::ConnectionReset
+            | ErrorKind::TimedOut
+            | ErrorKind::AddrNotAvailable
+            | ErrorKind::NotFound
+    )
+}
+
+pub(super) fn retryable_transport(error: &anyhow::Error, direct: bool) -> bool {
+    // A tungstenite TLS/HTTP/protocol failure is authoritative: never inspect
+    // nested IO errors or string messages to turn it into an eligible failure.
+    for source in error.chain() {
+        if let Some(ws) = source.downcast_ref::<tungstenite::Error>() {
+            return matches!(ws, tungstenite::Error::Io(io) if retryable_io_kind(io.kind(), direct));
+        }
+    }
+    error.chain().any(|source| {
+        source.is::<tokio::time::error::Elapsed>()
+            || source
+                .downcast_ref::<io::Error>()
+                .is_some_and(|io| retryable_io_kind(io.kind(), direct))
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn transport_classification_never_falls_back_on_http_or_tls() {
+        let redirect = tungstenite::Error::Http(Box::new(
+            tungstenite::http::Response::builder()
+                .status(301)
+                .body(Some(Vec::new()))
+                .unwrap(),
+        ));
+        assert!(!retryable_transport(&anyhow::Error::new(redirect), true));
+        let refused = anyhow::Error::new(io::Error::new(
+            ErrorKind::ConnectionRefused, "offline",
+        ));
+        assert!(retryable_transport(&refused, true));
+        assert!(retryable_transport(&refused, false));
+        let dns = anyhow::Error::new(io::Error::new(ErrorKind::Other, "dns error"));
+        assert!(retryable_transport(&dns, true));
+        assert!(!retryable_transport(&dns, false));
+        assert!(!retryable_transport(&anyhow::Error::msg("TLS certificate mismatch"), true));
+    }
+}
