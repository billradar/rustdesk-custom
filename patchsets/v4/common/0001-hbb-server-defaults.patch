+/// Android's file-transfer home is external storage. Diagnostics must instead use
+/// internal files storage next to PathProvider's application-documents directory.
+pub fn diagnostics_path() -> Option<std::path::PathBuf> {
+    #[cfg(target_os = "android")]
+    {
+        let app_dir = std::path::PathBuf::from(config::APP_DIR.read().unwrap().clone());
+        if !app_dir.is_absolute() || app_dir.file_name()? != "app_flutter" {
+            return None;
+        }
+        let path = app_dir.parent()?.join("files").join("diagnostics");
+        std::fs::create_dir_all(&path).ok()?;
+        std::fs::canonicalize(path).ok()
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        Some(config::Config::log_path().join("diagnostics"))
+    }
+}
+
+/// All app-managed legacy file output is metadata only. Never format record.args().
+pub fn diagnostic_format(
+    w: &mut dyn std::io::Write,
+    _now: &mut flexi_logger::DeferredNow,
+    record: &log::Record,
+) -> std::io::Result<()> {
+    if record.level() == log::Level::Error {
+        write!(
+            w,
+            "{} ERROR diagnostic event (details omitted)",
+            chrono::Utc::now().to_rfc3339()
+        )
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(not(debug_assertions))]
+struct DiagnosticWriter(flexi_logger::writers::FileLogWriter);
+#[cfg(not(debug_assertions))]
+impl flexi_logger::writers::LogWriter for DiagnosticWriter {
+    fn write(
+        &self,
+        now: &mut flexi_logger::DeferredNow,
+        record: &log::Record,
+    ) -> std::io::Result<()> {
+        radar_diagnostics::legacy(record);
+        if record.level() == log::Level::Error {
+            flexi_logger::writers::LogWriter::write(&self.0, now, record)
+        } else {
+            Ok(())
+        }
+    }
+    fn flush(&self) -> std::io::Result<()> {
+        flexi_logger::writers::LogWriter::flush(&self.0)
+    }
+}
