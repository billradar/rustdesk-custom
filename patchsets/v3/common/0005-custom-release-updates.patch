diff --git a/src/custom_update/mod.rs b/src/custom_update/mod.rs
new file mode 100644
index 0000000..9a96383
--- /dev/null
+++ b/src/custom_update/mod.rs
@@ -0,0 +1,686 @@
+//! JSON-only custom updates with offline Sigstore provenance verification.
+use hbb_common::{anyhow::anyhow, bail, ResultType};
+use serde_derive::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use std::{
+    fs,
+    io::{Read, Write},
+    path::{Path, PathBuf},
+    sync::Mutex,
+    time::Duration,
+};
+mod policy;
+use rustdesk_update_manifest::{Expected, Manifest, MANIFEST};
+pub const MANUAL_INSTALL_ONLY: bool = true;
+const MAX_ASSET: u64 = 1024 * 1024 * 1024;
+
+#[derive(Deserialize)]
+struct Build {
+    repository: String,
+    repository_id: Option<String>,
+    repository_owner_id: Option<String>,
+    version: String,
+    revision: Option<String>,
+    upstream_sha: String,
+    variant: String,
+    build_run: String,
+    #[serde(default)]
+    version_semantics: Option<String>,
+    #[serde(default)]
+    patchset_version: Option<String>,
+    #[serde(default)]
+    channel: Option<String>,
+}
+#[derive(Clone, Debug, Deserialize, PartialEq)]
+struct Asset {
+    id: u64,
+    name: String,
+    size: u64,
+    digest: Option<String>,
+    browser_download_url: String,
+    state: String,
+}
+#[derive(Clone, Debug, Deserialize)]
+struct Release {
+    id: u64,
+    tag_name: String,
+    draft: bool,
+    prerelease: bool,
+    immutable: bool,
+    html_url: String,
+    #[serde(skip)]
+    verified_manifest: Option<Manifest>,
+    assets: Vec<Asset>,
+}
+#[derive(Clone)]
+struct Candidate {
+    release: Release,
+    asset: Asset,
+}
+#[derive(Clone)]
+struct Downloaded {
+    candidate: Candidate,
+    path: PathBuf,
+}
+lazy_static::lazy_static! {
+    static ref CANDIDATE: Mutex<Option<Candidate>> = Mutex::new(None);
+    static ref DOWNLOADED: Mutex<Option<Downloaded>> = Mutex::new(None);
+    static ref OPERATION: Mutex<()> = Mutex::new(());
+}
+fn build() -> ResultType<Build> {
+    let b: Build = serde_json::from_str(include_str!("build.json"))?;
+    if !policy::build_semantics(
+        b.version_semantics.as_deref(),
+        b.patchset_version.as_deref(),
+        b.revision.as_deref(),
+        b.channel.as_deref(),
+    ) || !policy::repository(&b.repository)
+        || !b
+            .repository_id
+            .as_deref()
+            .is_some_and(|s| s.parse::<u64>().is_ok_and(|n| n > 0))
+        || !b
+            .repository_owner_id
+            .as_deref()
+            .is_some_and(|s| s.parse::<u64>().is_ok_and(|n| n > 0))
+        || policy::numeric::<3>(&b.version).is_none()
+        || !policy::hex(&b.upstream_sha, 40)
+        || !matches!(b.variant.as_str(), "standard" | "sos")
+        || b.build_run.parse::<u64>().is_err()
+        || b.revision
+            .as_ref()
+            .is_some_and(|r| policy::numeric::<2>(r.trim_start_matches('v')).is_none())
+    {
+        bail!("Custom update build identity unavailable; install a qualified build first");
+    }
+    Ok(b)
+}
+pub fn display_version() -> String {
+    match build() {
+        Ok(b) => match b.revision {
+            Some(r) => format!("{}-custom.{}", b.version, r),
+            None => match b.patchset_version {
+                Some(v) => format!(
+                    "{}-custom.{}-{}",
+                    b.version,
+                    v,
+                    b.channel.as_deref().unwrap_or("ci")
+                ),
+                None => format!("{}-custom.build{}", b.version, b.build_run),
+            },
+        },
+        Err(_) => crate::VERSION.to_owned(),
+    }
+}
+fn allowed_host(host: &str) -> bool {
+    host == "github.com" || host == "api.github.com" || host.ends_with(".githubusercontent.com")
+}
+fn client() -> ResultType<reqwest::blocking::Client> {
+    // No embedded token, insecure TLS exception, or official-server fallback.
+    Ok(reqwest::blocking::Client::builder()
+        .https_only(true)
+        .user_agent("rustdesk-custom-updater/1")
+        .connect_timeout(Duration::from_secs(15))
+        .timeout(Duration::from_secs(900))
+        .redirect(reqwest::redirect::Policy::custom(|attempt| {
+            if attempt.previous().len() >= 5
+                || attempt.url().scheme() != "https"
+                || !attempt.url().host_str().is_some_and(allowed_host)
+            {
+                attempt.error("Untrusted update redirect")
+            } else {
+                attempt.follow()
+            }
+        }))
+        .build()?)
+}
+fn release_api(b: &Build) -> ResultType<String> {
+    if !policy::repository(&b.repository) {
+        bail!("Update repository identity unavailable");
+    }
+    Ok(format!(
+        "https://api.github.com/repos/{}/releases/latest",
+        b.repository
+    ))
+}
+fn github_json(url: &str, limit: usize) -> ResultType<Value> {
+    let mut response = client()?.get(url).timeout(Duration::from_secs(30))
+        .header("Accept", "application/vnd.github+json").send()?.error_for_status()?;
+    let mut bytes = Vec::new();
+    response.by_ref().take(limit as u64 + 1).read_to_end(&mut bytes)?;
+    if bytes.len() > limit { bail!("GitHub metadata exceeds size limit"); }
+    Ok(serde_json::from_slice(&bytes)?)
+}
+fn native_proof(b: &Build, manifest: &[u8]) -> ResultType<Vec<u8>> {
+    let url = format!("https://api.github.com/repos/{}/attestations/sha256:{:x}?per_page=2&predicate_type=release&initiator=github",
+        b.repository, Sha256::digest(manifest));
+    let response = github_json(&url, rustdesk_update_manifest::MAX_PROOF)?;
+    rustdesk_update_manifest::native_bundle(&response, b.repository_id.as_deref().unwrap_or(""))
+        .map_err(|e| anyhow!(e))
+}
+fn release_git_object(b: &Build, r: &Release) -> ResultType<(String,String)> {
+    let reference = github_json(&format!("https://api.github.com/repos/{}/git/ref/tags/{}",b.repository,r.tag_name), 65536)?;
+    let mut object = reference["object"].clone();
+    let tag_sha = object["sha"].as_str().unwrap_or("").to_string();
+    for _ in 0..8 {
+        let sha = object["sha"].as_str().unwrap_or("");
+        if !policy::hex(sha,40) { bail!("Invalid Release Git object"); }
+        match object["type"].as_str() {
+            Some("commit") => return Ok((tag_sha,sha.to_string())),
+            Some("tag") => {
+                let tag = github_json(&format!("https://api.github.com/repos/{}/git/tags/{sha}",b.repository),65536)?;
+                object = tag["object"].clone();
+            }
+            _ => bail!("Release tag does not resolve to a commit"),
+        }
+    }
+    bail!("Release annotated tag chain exceeds limit")
+}
+
+fn get_release(b: &Build) -> ResultType<Release> {
+    let mut response = client()?
+        .get(release_api(b)?)
+        .timeout(Duration::from_secs(30))
+        .header("Accept", "application/vnd.github+json")
+        .send()?
+        .error_for_status()?;
+    let mut bytes = Vec::new();
+    response
+        .by_ref()
+        .take(4 * 1024 * 1024 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > 4 * 1024 * 1024 {
+        bail!("Release response too large");
+    }
+    let mut r: Release = serde_json::from_slice(&bytes)?;
+    validate_release(&r, b)?;
+    let manifest = metadata_bytes(&r, b, MANIFEST, rustdesk_update_manifest::MAX_MANIFEST)?;
+    let proof = native_proof(b, &manifest)?;
+    let (tag_sha, commit_sha) = release_git_object(b, &r)?;
+    let expected = Expected {
+        repository: &b.repository,
+        repository_id: b.repository_id.as_deref().unwrap_or(""),
+        owner_id: b.repository_owner_id.as_deref().unwrap_or(""),
+        tag: &r.tag_name,
+    };
+    let verified =
+        rustdesk_update_manifest::verify(&manifest, &proof, expected, r.id, &tag_sha).map_err(|e| anyhow!(e))?;
+    if verified.custom_repository_sha != commit_sha {
+        bail!("Native Release tag differs from manifest source commit");
+    }
+    // Require the attested inventory to cover exactly the API's installer assets.
+    let mut names = std::collections::BTreeSet::new();
+    for a in &r.assets {
+        if !names.insert(a.name.as_str()) {
+            bail!("Duplicate Release asset name");
+        }
+        if a.name == MANIFEST {
+            continue;
+        }
+        let item = verified
+            .assets
+            .iter()
+            .find(|item| item.name == a.name)
+            .ok_or_else(|| anyhow!("Unattested Release asset"))?;
+        validate_asset(&r, b, a)?;
+        if item.size != a.size
+            || a.digest.as_deref() != Some(format!("sha256:{}", item.sha256).as_str())
+        {
+            bail!("Release asset differs from attested manifest");
+        }
+    }
+    if r.assets.len() != verified.assets.len() + 1 {
+        bail!("Attested Release asset missing");
+    }
+    r.verified_manifest = Some(verified);
+    Ok(r)
+}
+fn validate_release(r: &Release, b: &Build) -> ResultType<()> {
+    let repository = &b.repository;
+    if r.id == 0
+        || !r.immutable
+        || r.draft
+        || r.prerelease
+        || policy::stable_tag(&r.tag_name).is_none()
+        || r.html_url
+            != format!(
+                "https://github.com/{repository}/releases/tag/{}",
+                r.tag_name
+            )
+    {
+        bail!("Latest is not a published custom Stable release");
+    }
+    Ok(())
+}
+fn source(r: &Release) -> ResultType<String> {
+    r.verified_manifest
+        .as_ref()
+        .map(|m| m.upstream_sha.clone())
+        .ok_or_else(|| anyhow!("Verified update manifest missing"))
+}
+fn validate_asset(r: &Release, b: &Build, a: &Asset) -> ResultType<()> {
+    if a.id == 0
+        || a.size == 0
+        || a.size > MAX_ASSET
+        || a.state != "uploaded"
+        || !a
+            .digest
+            .as_deref()
+            .and_then(|d| d.strip_prefix("sha256:"))
+            .is_some_and(|d| policy::hex(d, 64))
+        || a.browser_download_url
+            != format!(
+                "https://github.com/{}/releases/download/{}/{}",
+                b.repository, r.tag_name, a.name
+            )
+    {
+        bail!("Update asset identity, digest or URL invalid");
+    }
+    Ok(())
+}
+fn metadata_bytes(r: &Release, b: &Build, name: &str, limit: usize) -> ResultType<Vec<u8>> {
+    let matches: Vec<_> = r.assets.iter().filter(|a| a.name == name).collect();
+    if matches.len() != 1 {
+        bail!("Update manifest or attestation missing/duplicated");
+    }
+    let a = matches[0];
+    validate_asset(r, b, a)?;
+    if a.size > limit as u64 {
+        bail!("Update metadata exceeds size limit");
+    }
+    let mut response = client()?
+        .get(&a.browser_download_url)
+        .timeout(Duration::from_secs(30))
+        .send()?
+        .error_for_status()?;
+    let mut bytes = Vec::new();
+    response.by_ref().take(a.size + 1).read_to_end(&mut bytes)?;
+    if bytes.len() as u64 != a.size
+        || a.digest.as_deref() != Some(format!("sha256:{:x}", Sha256::digest(&bytes)).as_str())
+    {
+        bail!("Update metadata size or SHA256 mismatch");
+    }
+    Ok(bytes)
+}
+fn package_format() -> ResultType<&'static str> {
+    #[cfg(target_os = "windows")]
+    {
+        if !crate::platform::is_cur_exe_the_installed() {
+            return Ok("exe");
+        }
+        return match crate::platform::is_msi_installed() {
+            Ok(true) => Ok("msi"),
+            Ok(false) => Ok("exe"),
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok("exe"),
+            Err(e) => Err(e.into()),
+        };
+    }
+    #[cfg(target_os = "macos")]
+    {
+        return Ok("dmg");
+    }
+    #[cfg(target_os = "android")]
+    {
+        return Ok("apk");
+    }
+    #[cfg(target_os = "linux")]
+    {
+        let executable = fs::canonicalize(std::env::current_exe()?)?;
+        let path = executable
+            .to_str()
+            .ok_or_else(|| anyhow!("Unsupported executable path"))?;
+        let wayland = cfg!(feature = "drm");
+        let expected_package = policy::linux_package_identity(wayland);
+        let deb_owns = (|| -> bool {
+            let Ok(owner) = std::process::Command::new("dpkg-query")
+                .args(["-S", "--", path])
+                .output()
+            else {
+                return false;
+            };
+            let Ok(status) = std::process::Command::new("dpkg-query")
+                .args(["-W", "-f=${Status}", expected_package])
+                .output()
+            else {
+                return false;
+            };
+            owner.status.success()
+                && status.status.success()
+                && policy::debian_owns_executable(
+                    wayland,
+                    path,
+                    &String::from_utf8_lossy(&owner.stdout),
+                    &String::from_utf8_lossy(&status.stdout),
+                )
+        })();
+        let rpm_owns = std::process::Command::new("rpm")
+            .args(["-qf", "--qf", "%{NAME}\n", "--", path])
+            .output()
+            .is_ok_and(|out| {
+                out.status.success()
+                    && out.stdout == format!("{expected_package}\n").as_bytes()
+            });
+        let os = fs::read_to_string("/etc/os-release").unwrap_or_default();
+        return rustdesk_update_manifest::linux_package_format(
+            deb_owns,
+            rpm_owns,
+            cfg!(feature = "drm"),
+            &os,
+        )
+        .map_err(|e| anyhow!(e));
+    }
+    #[cfg(not(any(
+        target_os = "windows",
+        target_os = "macos",
+        target_os = "android",
+        target_os = "linux"
+    )))]
+    bail!("Updates are not supported on this platform");
+}
+fn selected_asset(r: &Release, b: &Build) -> ResultType<Asset> {
+    let arch = if cfg!(all(target_os = "android", target_arch = "arm")) {
+        "armv7"
+    } else {
+        std::env::consts::ARCH
+    };
+    asset_for(
+        r,
+        b,
+        std::env::consts::OS,
+        arch,
+        cfg!(all(target_os = "linux", feature = "drm")),
+        package_format()?,
+    )
+}
+fn asset_for(
+    r: &Release,
+    b: &Build,
+    platform: &str,
+    arch: &str,
+    wayland: bool,
+    format: &str,
+) -> ResultType<Asset> {
+    let manifest = r
+        .verified_manifest
+        .as_ref()
+        .ok_or_else(|| anyhow!("Verified update manifest required before package selection"))?;
+    let item = manifest
+        .selected(platform, arch, &b.variant, wayland, format)
+        .map_err(|e| anyhow!(e))?;
+    let matches: Vec<_> = r.assets.iter().filter(|a| a.name == item.name).collect();
+    if matches.len() != 1 {
+        bail!("Matching update package missing or duplicated");
+    }
+    let a = matches[0];
+    validate_asset(r, b, a)?;
+    if a.size != item.size
+        || a.digest.as_deref() != Some(format!("sha256:{}", item.sha256).as_str())
+    {
+        bail!("Update package differs from attested selector");
+    }
+    Ok(a.clone())
+}
+
+fn clear() {
+    *CANDIDATE.lock().unwrap() = None;
+    *super::SOFTWARE_UPDATE_URL.lock().unwrap() = String::new();
+}
+pub fn check() -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    clear();
+    let b = build()?;
+    let r = get_release(&b)?;
+    let (version, revision) = policy::stable_tag(&r.tag_name).unwrap();
+    let installed_revision = b
+        .revision
+        .as_deref()
+        .and_then(|v| policy::numeric::<2>(v.trim_start_matches('v')));
+    if !policy::newer(
+        policy::numeric(&b.version).unwrap(),
+        installed_revision,
+        &b.upstream_sha,
+        version,
+        revision,
+        &source(&r)?,
+    ) {
+        return Ok(json!({"status":"current","current":display_version()}));
+    }
+    let asset = selected_asset(&r, &b)?;
+    *CANDIDATE.lock().unwrap() = Some(Candidate {
+        release: r.clone(),
+        asset,
+    });
+    *super::SOFTWARE_UPDATE_URL.lock().unwrap() = r.html_url.clone();
+    #[cfg(feature = "flutter")]
+    {
+        let event = json!({"name":"check_software_update_finish","url":r.html_url}).to_string();
+        let _ = crate::flutter::push_global_event(crate::flutter::APP_TYPE_MAIN, event);
+    }
+    Ok(
+        json!({"status":"available","version":r.tag_name,"url":r.html_url,"current":display_version()}),
+    )
+}
+fn verify_file(path: &Path, a: &Asset) -> ResultType<()> {
+    let meta = fs::symlink_metadata(path)?;
+    if !meta.is_file() || meta.len() != a.size {
+        bail!("Update size mismatch");
+    }
+    let mut file = fs::File::open(path)?;
+    let mut digest = Sha256::new();
+    let mut buf = [0u8; 65536];
+    loop {
+        let n = file.read(&mut buf)?;
+        if n == 0 {
+            break;
+        }
+        digest.update(&buf[..n]);
+    }
+    if a.digest.as_deref() != Some(format!("sha256:{:x}", digest.finalize()).as_str()) {
+        bail!("Update SHA256 mismatch");
+    }
+    Ok(())
+}
+fn download(request: &str) -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    let req: Value = serde_json::from_str(request)?;
+    let c = CANDIDATE
+        .lock()
+        .unwrap()
+        .clone()
+        .ok_or_else(|| anyhow!("Check for updates first"))?;
+    if req["release"].as_u64() != Some(c.release.id) || req["asset"].as_u64() != Some(c.asset.id) {
+        bail!("Update selection expired; check again");
+    }
+    // Revalidate latest immediately before download. Closed/replaced Releases fail closed.
+    let b = build()?;
+    let r = get_release(&b)?;
+    if r.id != c.release.id
+        || r.tag_name != c.release.tag_name
+        || r.verified_manifest != c.release.verified_manifest
+        || selected_asset(&r, &b)? != c.asset
+    {
+        clear();
+        bail!("Release changed; check again");
+    }
+    let directory = PathBuf::from(
+        req["directory"]
+            .as_str()
+            .ok_or_else(|| anyhow!("Download directory missing"))?,
+    );
+    if !directory.is_absolute() || !directory.is_dir() {
+        bail!("Invalid download directory");
+    }
+    let parent = directory.join("custom-updates");
+    let mut builder = fs::DirBuilder::new();
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::DirBuilderExt;
+        builder.mode(0o700);
+    }
+    match builder.create(&parent) {
+        Ok(()) => (),
+        Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => (),
+        Err(e) => return Err(e.into()),
+    }
+    let metadata = fs::symlink_metadata(&parent)?;
+    if !metadata.is_dir() {
+        bail!("Unsafe update directory");
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { hbb_common::libc::geteuid() } || metadata.mode() & 0o077 != 0
+        {
+            bail!("Update directory must be private and owned by the current user");
+        }
+    }
+    let nonce = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)?
+        .as_nanos();
+    let folder = parent.join(format!("{}-{nonce}", std::process::id()));
+    builder.create(&folder)?;
+    let path = folder.join(&c.asset.name);
+    let result = (|| -> ResultType<()> {
+        let mut response = client()?
+            .get(&c.asset.browser_download_url)
+            .send()?
+            .error_for_status()?;
+        if response.content_length().is_some_and(|n| n != c.asset.size) {
+            bail!("Update content length mismatch");
+        }
+        let mut file = fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)?;
+        let copied = std::io::copy(&mut response.by_ref().take(c.asset.size + 1), &mut file)?;
+        file.flush()?;
+        file.sync_all()?;
+        drop(file);
+        if copied != c.asset.size {
+            bail!("Update download truncated or oversized");
+        }
+        verify_file(&path, &c.asset)
+    })();
+    if let Err(e) = result {
+        let _ = fs::remove_file(&path);
+        let _ = fs::remove_dir(&folder);
+        return Err(e);
+    }
+    *DOWNLOADED.lock().unwrap() = Some(Downloaded {
+        candidate: c,
+        path: path.clone(),
+    });
+    Ok(json!({"path":path,"status":"downloaded"}))
+}
+fn open_download() -> ResultType<Value> {
+    let _guard = OPERATION.lock().unwrap();
+    let d = DOWNLOADED
+        .lock()
+        .unwrap()
+        .clone()
+        .ok_or_else(|| anyhow!("No verified update downloaded"))?;
+    verify_file(&d.path, &d.candidate.asset)?;
+    #[cfg(target_os = "windows")]
+    {
+        if d.path.extension().and_then(|s| s.to_str()) == Some("msi") {
+            std::process::Command::new("msiexec.exe")
+                .arg("/i")
+                .arg(&d.path)
+                .spawn()?;
+        } else {
+            std::process::Command::new(&d.path).spawn()?;
+        }
+    }
+    #[cfg(target_os = "macos")]
+    {
+        std::process::Command::new("open").arg(&d.path).spawn()?;
+    }
+    #[cfg(target_os = "linux")]
+    {
+        std::process::Command::new("xdg-open")
+            .arg(&d.path)
+            .spawn()?;
+    }
+    // Android hands the verified private-cache APK to its system installer via FileProvider.
+    Ok(json!({"status":"opened","path":d.path}))
+}
+pub fn response(key: &str) -> Option<String> {
+    if !key.starts_with("custom-update-") {
+        return None;
+    }
+    let result = if key == "custom-update-check" {
+        check()
+    } else if key == "custom-update-info" {
+        Ok(match CANDIDATE.lock().unwrap().as_ref() {
+            Some(c) => {
+                json!({"status":"available","version":c.release.tag_name,"url":c.release.html_url,
+                "release":c.release.id,"asset":c.asset.id,"size":c.asset.size,"current":display_version()})
+            }
+            None => json!({"status":"current","current":display_version()}),
+        })
+    } else if let Some(request) = key.strip_prefix("custom-update-download:") {
+        download(request)
+    } else if key == "custom-update-open" {
+        open_download()
+    } else {
+        Err(anyhow!("Unsupported custom update request"))
+    };
+    Some(match result {
+        Ok(v) => v.to_string(),
+        Err(e) => json!({"status":"unavailable","error":e.to_string()}).to_string(),
+    })
+}
+pub fn new_version() -> String {
+    CANDIDATE
+        .lock()
+        .unwrap()
+        .as_ref()
+        .map(|c| c.release.tag_name.clone())
+        .unwrap_or_default()
+}
+
