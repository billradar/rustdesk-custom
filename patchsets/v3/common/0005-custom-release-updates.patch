@@ -0,0 +1,461 @@
+//! Offline Sigstore verification and typed update selection. No shell or gh dependency.
+use serde::Deserialize;
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use sigstore_verify::{
+    trust_root::{TrustedRoot, SIGSTORE_GITHUB_TRUSTED_ROOT},
+    types::{Artifact, Bundle, Sha256Hash, SignatureContent},
+    VerificationPolicy,
+};
+use std::collections::{BTreeMap, BTreeSet};
+
+pub const MANIFEST: &str = "update-manifest.json";
+pub const SCHEMA: &str = "rustdesk-release-manifest-v2";
+pub const MAX_MANIFEST: usize = 1024 * 1024;
+pub const MAX_PROOF: usize = 8 * 1024 * 1024;
+pub type Result<T> = std::result::Result<T, String>;
+
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Package {
+    pub name: String,
+    pub size: u64,
+    pub sha256: String,
+    pub os: String,
+    pub arch: String,
+    pub variant: String,
+    pub flavor: String,
+    pub package: String,
+    pub signing_status: String,
+}
+#[derive(Clone, Debug, PartialEq, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Manifest {
+    pub schema: String,
+    pub repository: String,
+    pub repository_id: String,
+    pub repository_owner_id: String,
+    pub channel: String,
+    pub upstream_repository: String,
+    pub upstream_version: String,
+    pub upstream_tag: Option<String>,
+    pub upstream_sha: String,
+    pub custom_repository_sha: String,
+    pub patchset: String,
+    pub common_patch_hash: String,
+    pub sos_patch_hash: String,
+    pub patch_revision: Option<String>,
+    pub patchset_version: String,
+    pub version_semantics: String,
+    pub prepare_run: String,
+    pub build_run: String,
+    pub build_identity: String,
+    pub wayland_included: bool,
+    pub wayland_policy_sha256: String,
+    pub android_signing_enabled: bool,
+    pub android_production_signed: bool,
+    pub official_run_id: Option<String>,
+    pub official_run_url: Option<String>,
+    pub qualification: String,
+    pub runtime_ui: String,
+    pub real_remote_session: String,
+    pub assets: Vec<Package>,
+}
+#[derive(Clone, Copy)]
+pub struct Expected<'a> {
+    pub repository: &'a str,
+    pub repository_id: &'a str,
+    pub owner_id: &'a str,
+    pub tag: &'a str,
+}
+
+pub fn hex(s: &str, n: usize) -> bool {
+    s.len() == n
+        && s.bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+fn positive(s: &str) -> bool {
+    !s.starts_with('0') && s.parse::<u64>().is_ok_and(|n| n > 0)
+}
+fn version(s: &str) -> bool {
+    let p: Vec<_> = s.split('.').collect();
+    p.len() == 3
+        && p.iter().all(|p| {
+            !p.is_empty()
+                && p.bytes().all(|x| x.is_ascii_digit())
+                && (p.len() == 1 || !p.starts_with('0'))
+                && p.parse::<u64>().is_ok()
+        })
+}
+fn content(s: &str) -> bool {
+    let Some((p, r)) = s.split_once('.') else {
+        return false;
+    };
+    p.starts_with('v') && positive(&p[1..]) && positive(r)
+}
+fn safe_name(s: &str) -> bool {
+    !s.is_empty()
+        && s.len() <= 255
+        && s.as_bytes()[0].is_ascii_alphanumeric()
+        && s.bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_' | b'.'))
+        && !matches!(s, MANIFEST | "release-attestation.json" | "SHA256SUMS")
+}
+fn require(ok: bool, msg: &str) -> Result<()> {
+    if ok {
+        Ok(())
+    } else {
+        Err(msg.to_string())
+    }
+}
+fn digest(raw: &[u8]) -> String {
+    format!("{:x}", Sha256::digest(raw))
+}
+
+impl Manifest {
+    pub fn parse(raw: &[u8], expected: Expected<'_>) -> Result<Self> {
+        require(
+            raw.len() <= MAX_MANIFEST,
+            "Update manifest exceeds size limit",
+        )?;
+        let v: Self =
+            serde_json::from_slice(raw).map_err(|e| format!("Invalid update manifest: {e}"))?;
+        v.validate(expected)?;
+        Ok(v)
+    }
+    pub fn validate(&self, e: Expected<'_>) -> Result<()> {
+        require(self.schema == SCHEMA, "Unsupported update manifest schema")?;
+        require(
+            self.repository == e.repository
+                && self.repository_id == e.repository_id
+                && self.repository_owner_id == e.owner_id
+                && positive(e.repository_id)
+                && positive(e.owner_id),
+            "Update repository identity mismatch",
+        )?;
+        require(
+            self.channel == "stable" && self.qualification == "PASS",
+            "Updates require a qualified Stable manifest",
+        )?;
+        require(
+            self.upstream_repository == "rustdesk/rustdesk" && version(&self.upstream_version),
+            "Invalid upstream version/source",
+        )?;
+        require(
+            self.upstream_tag.as_deref() == Some(&self.upstream_version)
+                || self.upstream_tag.as_deref()
+                    == Some(format!("v{}", self.upstream_version).as_str()),
+            "Official Stable tag missing",
+        )?;
+        require(
+            self.version_semantics == "patchset-content-v1"
+                && content(&self.patchset_version)
+                && self.patch_revision.as_ref() == Some(&self.patchset_version),
+            "Unsupported content revision semantics",
+        )?;
+        require(
+            self.patchset_version
+                .starts_with(&format!("{}.", self.patchset))
+                && e.tag
+                    == format!(
+                        "v{}-custom.{}",
+                        self.upstream_version, self.patchset_version
+                    ),
+            "Release tag/content revision mismatch",
+        )?;
+        for (s, n) in [
+            (&self.upstream_sha, 40),
+            (&self.custom_repository_sha, 40),
+            (&self.common_patch_hash, 64),
+            (&self.sos_patch_hash, 64),
+        ] {
+            require(hex(s, n), "Invalid update source/hash")?;
+        }
+        require(
+            positive(&self.build_run)
+                && self.prepare_run == self.build_run
+                && self.official_run_id.is_none()
+                && self.official_run_url.is_none(),
+            "Invalid Stable build provenance",
+        )?;
+        require(
+            (self.wayland_included && hex(&self.wayland_policy_sha256, 64))
+                || (!self.wayland_included && self.wayland_policy_sha256.is_empty()),
+            "Invalid Wayland build policy",
+        )?;
+        let identity: BTreeMap<&str, Value> = [
+            ("schema", json!("stable-build-identity-v4")),
+            ("upstream_sha", json!(self.upstream_sha)),
+            ("patchset", json!(self.patchset)),
+            ("common_patch_hash", json!(self.common_patch_hash)),
+            ("sos_patch_hash", json!(self.sos_patch_hash)),
+            ("wayland_included", json!(self.wayland_included)),
+            ("wayland_policy_sha256", json!(self.wayland_policy_sha256)),
+            (
+                "android_signing_enabled",
+                json!(self.android_signing_enabled),
+            ),
+        ]
+        .into_iter()
+        .collect();
+        require(
+            self.build_identity
+                == digest(&serde_json::to_vec(&identity).map_err(|e| e.to_string())?),
+            "Update build identity mismatch",
+        )?;
+        require(
+            !self.assets.is_empty() && self.assets.len() <= 256,
+            "Invalid update package count",
+        )?;
+        let mut names = BTreeSet::new();
+        let mut selectors = BTreeSet::new();
+        let mut wayland = BTreeSet::new();
+        let mut android = BTreeSet::new();
+        let mut signed = true;
+        for a in &self.assets {
+            require(
+                safe_name(&a.name)
+                    && a.size > 0
+                    && a.size <= 1024 * 1024 * 1024
+                    && hex(&a.sha256, 64),
+                "Invalid update package name/size/digest",
+            )?;
+            require(
+                matches!(a.variant.as_str(), "standard" | "sos")
+                    && matches!(a.arch.as_str(), "x86_64" | "aarch64" | "armv7"),
+                "Invalid update package variant/architecture",
+            )?;
+            let family = match a.os.as_str() {
+                "windows" => matches!(a.package.as_str(), "exe" | "msi"),
+                "macos" => a.package == "dmg",
+                "linux" => matches!(a.package.as_str(), "deb" | "rpm" | "suse-rpm"),
+                "android" => a.package == "apk" && a.variant == "standard",
+                _ => false,
+            };
+            require(
+                family && (a.arch != "armv7" || a.os == "android"),
+                "Invalid update package OS/family",
+            )?;
+            let ext = if a.package == "suse-rpm" {
+                "rpm"
+            } else {
+                &a.package
+            };
+            require(
+                a.name.ends_with(&format!(".{ext}")),
+                "Update package extension mismatch",
+            )?;
+            require(
+                matches!(a.flavor.as_str(), "ordinary" | "unattended-wayland"),
+                "Unknown update build flavor",
+            )?;
+            if a.flavor == "unattended-wayland" {
+                require(
+                    a.os == "linux" && a.package == "deb",
+                    "Wayland package family mismatch",
+                )?;
+                wayland.insert((a.variant.as_str(), a.arch.as_str()));
+            }
+            require(
+                matches!(
+                    a.signing_status.as_str(),
+                    "NOT ENABLED"
+                        | "TEST SIGNED / NOT PRODUCTION SIGNED"
+                        | "PRODUCTION SIGNED / IDENTITY VERIFIED"
+                ),
+                "Unknown package signing state",
+            )?;
+            if a.os == "android" {
+                android.insert(a.arch.as_str());
+                signed &= a.signing_status == "PRODUCTION SIGNED / IDENTITY VERIFIED";
+            }
+            require(
+                names.insert(a.name.as_str())
+                    && selectors.insert((&a.os, &a.arch, &a.variant, &a.flavor, &a.package)),
+                "Ambiguous update package name/selector",
+            )?;
+        }
+        require(
+            self.wayland_included == !wayland.is_empty(),
+            "Wayland option/inventory mismatch",
+        )?;
+        let prod = android.len() == 3 && signed;
+        require(
+            self.android_production_signed == prod && (!self.android_signing_enabled || prod),
+            "Android production signing requirement unmet",
+        )?;
+        Ok(())
+    }
+    pub fn selected(
+        &self,
+        os: &str,
+        arch: &str,
+        variant: &str,
+        wayland: bool,
+        package: &str,
+    ) -> Result<&Package> {
+        let format = if package == "suse.rpm" {
+            "suse-rpm"
+        } else {
+            package
+        };
+        let flavor = if wayland {
+            "unattended-wayland"
+        } else {
+            "ordinary"
+        };
+        let mut matching = self.assets.iter().filter(|a| {
+            a.os == os
+                && a.arch == arch
+                && a.variant == variant
+                && a.flavor == flavor
+                && a.package == format
+        });
+        let asset=matching.next().ok_or_else(||"No update package matches this OS, architecture, variant, flavor and package format".to_string())?;
+        require(
+            matching.next().is_none(),
+            "Multiple matching update packages",
+        )?;
+        Ok(asset)
+    }
+}
+
+/// The discovery API is untrusted transport; identity is subsequently checked in the signed proof.
+pub fn native_bundle(response: &Value, repository_id: &str) -> Result<Vec<u8>> {
+    let rows = response["attestations"].as_array().ok_or("Native Release proof missing")?;
+    require(rows.len() == 1, "Native Release proof missing or ambiguous")?;
+    let row = &rows[0];
+    require(row["initiator"] == "github"
+        && row["repository_id"].as_u64().map(|n| n.to_string()).as_deref() == Some(repository_id),
+        "Native proof API repository mismatch")?;
+    let raw = serde_json::to_vec(row.get("bundle").ok_or("Native bundle missing")?).map_err(|e|e.to_string())?;
+    require(raw.len() <= MAX_PROOF, "Native bundle exceeds limit")?;
+    Ok(raw)
+}
+
+/// Verify GitHub's native Release service proof, including the entire immutable inventory.
+pub fn verify_release_proof(
+    proof: &[u8], e: Expected<'_>, release_id: u64, tag_sha: &str,
+    files: &BTreeMap<String, String>,
+) -> Result<()> {
+    require(proof.len() <= MAX_PROOF && release_id > 0 && hex(tag_sha, 40)
+        && !files.is_empty() && files.values().all(|v| hex(v,64)), "Invalid native proof inputs")?;
+    let bundle = Bundle::from_json(std::str::from_utf8(proof).map_err(|e| e.to_string())?)
+        .map_err(|e| e.to_string())?;
+    require(bundle.media_type == "application/vnd.dev.sigstore.bundle.v0.3+json",
+        "Unsupported native proof format")?;
+    require(!bundle.verification_material.timestamp_verification_data.rfc3161_timestamps.is_empty(),
+        "Native Release proof requires signed GitHub TSA evidence")?;
+    let root = TrustedRoot::from_json(SIGSTORE_GITHUB_TRUSTED_ROOT).map_err(|e| e.to_string())?;
+    // GitHub's release service has a dedicated CA/TSA; it does not use public Rekor/SCT.
+    let policy = VerificationPolicy::default().require_identity("https://dotcom.releases.github.com")
+        .skip_tlog().skip_sct();
+    let (name, sha) = files.iter().next().ok_or("Native inventory missing")?;
+    let hash = Sha256Hash::from_hex(sha).map_err(|e| e.to_string())?;
+    sigstore_verify::verify(Artifact::from_digest(hash.as_bytes()), &bundle, &policy, &root)
+        .map_err(|e| format!("Native Release verification failed: {e}"))?;
+    let envelope = match &bundle.content {
+        SignatureContent::DsseEnvelope(v) => v,
+        _ => return Err("Native proof requires DSSE".into()),
+    };
+    require(envelope.payload_type == "application/vnd.in-toto+json", "Invalid native payload type")?;
+    let statement: Value = serde_json::from_slice(envelope.payload.as_bytes()).map_err(|e| e.to_string())?;
+    validate_release_statement(&statement, e, release_id, tag_sha, files)?;
+    require(statement["subject"].as_array().is_some_and(|rows| rows.iter().any(|s| s["name"] == name.as_str())),
+        "Verified subject name absent")?;
+    Ok(())
+}
+
+pub fn validate_release_statement(
+    statement: &Value, e: Expected<'_>, release_id: u64, tag_sha: &str,
+    files: &BTreeMap<String, String>,
+) -> Result<()> {
+    require(statement["_type"] == "https://in-toto.io/Statement/v1"
+        && statement["predicateType"] == "https://in-toto.io/attestation/release/v0.2",
+        "Not a native Release v0.2 statement")?;
+    let purl = format!("pkg:github/{}@{}", e.repository, e.tag);
+    let predicate = &statement["predicate"];
+    for (key, wanted) in [("databaseId",release_id.to_string()),("ownerId",e.owner_id.into()),
+        ("repositoryId",e.repository_id.into()),("packageId",e.repository_id.into()),
+        ("repository",e.repository.into()),("tag",e.tag.into()),("purl",purl.clone())] {
+        require(predicate[key] == wanted, "Native release/repository/owner/tag identity mismatch")?;
+    }
+    let subjects = statement["subject"].as_array().ok_or("Native subjects missing")?;
+    let mut actual = BTreeMap::new();
+    let mut refs = 0;
+    for subject in subjects {
+        if subject["uri"] == purl {
+            require(subject["digest"] == json!({"sha1":tag_sha}) && subject.get("name").is_none(),
+                "Native Git object mismatch")?;
+            refs += 1;
+        } else {
+            let name = subject["name"].as_str().ok_or("Native subject name missing")?;
+            let sha = subject["digest"]["sha256"].as_str().ok_or("Native asset digest missing")?;
+            require(subject.get("uri").is_none() && subject["digest"] == json!({"sha256":sha})
+                && actual.insert(name.to_string(),sha.to_string()).is_none(),
+                "Duplicate or ambiguous native subject")?;
+        }
+    }
+    require(refs == 1 && &actual == files, "Native proof must cover exact Git object and complete asset inventory")
+}
+
+pub fn verify(raw: &[u8], proof: &[u8], e: Expected<'_>, release_id: u64, tag_sha: &str) -> Result<Manifest> {
+    let manifest = Manifest::parse(raw, e)?;
+    let mut files: BTreeMap<String,String> = manifest.assets.iter().map(|a| (a.name.clone(),a.sha256.clone())).collect();
+    files.insert(MANIFEST.to_string(),digest(raw));
+    verify_release_proof(proof,e,release_id,tag_sha,&files)?;
+    Ok(manifest)
+}
+
+/// Package-manager presence is insufficient: callers must establish executable ownership.
+pub fn linux_package_format(
+    deb_owns: bool,
+    rpm_owns: bool,
+    wayland: bool,
+    os_release: &str,
+) -> Result<&'static str> {
+    require(
+        deb_owns != rpm_owns,
+        "Current executable has no unique installed DEB/RPM owner; choose a package manually",
+    )?;
+    if deb_owns {
+        return Ok("deb");
+    }
+    require(
+        !wayland,
+        "Wayland unattended builds require a managed DEB installation",
+    )?;
+    let mut id = None;
+    let mut like = String::new();
+    for line in os_release.lines() {
+        if let Some((key, value)) = line.split_once('=') {
+            let value = value.trim().trim_matches('\"').trim_matches('\'');
+            if key == "ID" {
+                require(id.is_none(), "Ambiguous Linux distribution identity")?;
+                id = Some(value.to_ascii_lowercase());
+            }
+            if key == "ID_LIKE" {
+                like = value.to_ascii_lowercase();
+            }
+        }
+    }
+    let id = id.ok_or_else(|| "Linux distribution identity unavailable".to_string())?;
+    require(
+        !id.is_empty()
+            && id
+                .bytes()
+                .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_')),
+        "Invalid Linux distribution identity",
+    )?;
+    let suse = |value: &str| {
+        matches!(
+            value,
+            "suse" | "sles" | "sled" | "opensuse" | "opensuse-leap" | "opensuse-tumbleweed"
+        )
+    };
+    Ok(if suse(&id) || like.split_whitespace().any(suse) {
+        "suse.rpm"
+    } else {
+        "rpm"
+    })
+}
