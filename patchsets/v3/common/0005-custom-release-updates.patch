+//! Numeric version and build identity policy; Release provenance is JSON-only.
+pub fn numeric<const N: usize>(value: &str) -> Option<[u64; N]> {
+    let parts: Vec<_> = value.split('.').collect();
+    if parts.len() != N {
+        return None;
+    }
+    let mut result = [0; N];
+    for (i, part) in parts.iter().enumerate() {
+        if part.is_empty() || !part.bytes().all(|c| c.is_ascii_digit()) {
+            return None;
+        }
+        result[i] = part.parse().ok()?;
+    }
+    Some(result)
+}
+pub fn stable_tag(tag: &str) -> Option<([u64; 3], [u64; 2])> {
+    let (version, revision) = tag.strip_prefix('v')?.split_once("-custom.v")?;
+    let revision: [u64; 2] = numeric(revision)?;
+    if revision.contains(&0) {
+        return None;
+    }
+    Some((numeric(version)?, revision))
+}
+pub fn build_semantics(
+    schema: Option<&str>,
+    content: Option<&str>,
+    revision: Option<&str>,
+    channel: Option<&str>,
+) -> bool {
+    match schema {
+        None => content.is_none() && channel.is_none(), // historical installed build
+        Some("patchset-content-v1") => {
+            let Some(version) = content else {
+                return false;
+            };
+            let Some(numbers) = version.strip_prefix('v').and_then(numeric::<2>) else {
+                return false;
+            };
+            if numbers.contains(&0) {
+                return false;
+            }
+            match channel {
+                Some("stable") => revision == Some(version),
+                Some("nightly" | "ci") => revision.is_none(),
+                _ => false,
+            }
+        }
+        _ => false,
+    }
+}
+
+pub fn newer(
+    current: [u64; 3],
+    revision: Option<[u64; 2]>,
+    source: &str,
+    remote: [u64; 3],
+    remote_revision: [u64; 2],
+    remote_source: &str,
+) -> bool {
+    if current != remote {
+        return remote > current;
+    }
+    match revision {
+        Some(local) => remote_revision > local,
+        // Non-release builds may move to Stable at the same version only when
+        // the exact upstream source agrees. Never guess Nightly chronology.
+        None => source == remote_source,
+    }
+}
+pub fn hex(value: &str, length: usize) -> bool {
+    value.len() == length
+        && value
+            .bytes()
+            .all(|c| c.is_ascii_digit() || (b'a'..=b'f').contains(&c))
+}
+/// Validate an embedded repository slug before making requests.
+pub fn repository(value: &str) -> bool {
+    let Some((owner, name)) = value.split_once('/') else {
+        return false;
+    };
+    !owner.is_empty()
+        && owner.len() <= 39
+        && !owner.starts_with('-')
+        && !owner.ends_with('-')
+        && owner
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'-')
+        && !name.is_empty()
+        && name.len() <= 100
+        && !matches!(name, "." | "..")
+        && name
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || matches!(c, b'-' | b'_' | b'.'))
+}
+
+pub fn package_name(
+    version: &str,
+    variant: &str,
+    platform: &str,
+    arch: &str,
+    wayland: bool,
+    format: &str,
+) -> Option<String> {
+    numeric::<3>(version)?;
+    if !matches!(variant, "standard" | "sos") || !matches!(arch, "x86_64" | "aarch64" | "armv7") {
+        return None;
+    }
+    let suffix = if variant == "sos" { "-sos" } else { "" };
+    if wayland {
+        if platform != "linux" || format != "deb" || arch == "armv7" {
+            return None;
+        }
+        return Some(format!(
+            "rustdesk-unattended-wayland-{variant}-{version}-{arch}.deb"
+        ));
+    }
+    let name = match (platform, format) {
+        ("windows", "exe" | "msi") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-windows-{arch}.{format}")
+        }
+        ("macos", "dmg") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-macos-{arch}-unsigned.dmg")
+        }
+        ("linux", "deb") if arch != "armv7" => {
+            format!("rustdesk-{version}{suffix}-linux-{arch}.deb")
+        }
+        ("linux", "rpm" | "suse.rpm") if arch != "armv7" => {
+            let tail = if format == "suse.rpm" {
+                "-suse.rpm"
+            } else {
+                ".rpm"
+            };
+            format!("rustdesk-{version}{suffix}-linux-{arch}{tail}")
+        }
+        ("android", "apk") if variant == "standard" => {
+            format!("rustdesk-{version}-android-{arch}-signed.apk")
+        }
+        _ => return None,
+    };
+    Some(name)
+}
+/// Internal package identity is independent of branding and Standard/SOS.
+pub fn linux_package_identity(wayland: bool) -> &'static str {
+    if wayland {
+        "rustdesk-unattended-wayland"
+    } else {
+        "rustdesk"
+    }
+}
+pub fn debian_owns_executable(wayland: bool, path: &str, owners: &str, status: &str) -> bool {
+    status == "install ok installed"
+        && owners.lines().any(|line| {
+            line.split_once(": ").is_some_and(|(owner, installed)| {
+                owner.split(':').next() == Some(linux_package_identity(wayland))
+                    && installed == path
+            })
+        })
+}
