+fn api_failover_proxy() -> Result<Option<reqwest::Proxy>, String> {
+    use hbb_common::{
+        config::Config,
+        proxy::{Proxy, ProxyScheme},
+    };
+    let Some(conf) = Config::get_socks() else {
+        return Ok(None);
+    };
+    let proxy = Proxy::from_conf(&conf, None).map_err(|_| "Invalid API proxy configuration")?;
+    let address = match &proxy.intercept {
+        ProxyScheme::Http { host, .. } => format!("http://{host}"),
+        ProxyScheme::Https { host, .. } => format!("https://{host}"),
+        ProxyScheme::Socks5 { addr, .. } => format!("socks5://{addr}"),
+    };
+    let mut result = reqwest::Proxy::all(address).map_err(|_| "Invalid API proxy")?;
+    if let Some(auth) = proxy.intercept.maybe_auth() {
+        result = result.basic_auth(auth.username(), auth.password());
+    }
+    Ok(Some(result))
+}
