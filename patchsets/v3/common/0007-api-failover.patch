index 0000000..9583fe4
--- /dev/null
+++ b/src/hbbs_http/api_failover.rs
@@ -0,0 +1,413 @@
+//! v3 only. Logical API identity stays primary; only the transport URL changes.
+use hbb_common::tokio;
+use reqwest::{header::HeaderMap, Client, Method, Response, Url};
+use std::{
+    sync::{Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+const CONNECT: Duration = Duration::from_secs(2);
+const REQUEST: Duration = Duration::from_secs(12);
+const COOLDOWN: Duration = Duration::from_secs(15);
+const PRIMARY: &str = env!("RUSTDESK_API_SERVER");
+// Version-scoped Actions policy; frozen before prepared-source inventory.
+include!("api_failover_policy.rs");
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Phase {
+    Primary,
+    PrimaryUnavailable,
+    Fallback,
+    RecoveryProbe,
+}
+struct State {
+    phase: Phase,
+    retry_at: Option<Instant>,
+    generation: u64,
+}
+static STATE: OnceLock<Mutex<State>> = OnceLock::new();
+fn state() -> &'static Mutex<State> {
+    STATE.get_or_init(|| {
+        Mutex::new(State {
+            phase: Phase::Primary,
+            retry_at: None,
+            generation: 0,
+        })
+    })
+}
+
+fn origin(value: &str) -> Option<Url> {
+    let u = Url::parse(value).ok()?;
+    (u.scheme() == "https"
+        && u.host_str().is_some()
+        && u.username().is_empty()
+        && u.password().is_none()
+        && u.path() == "/"
+        && u.query().is_none()
+        && u.fragment().is_none())
+    .then_some(u)
+}
+fn endpoints() -> Option<(Url, Url)> {
+    let primary = origin(PRIMARY)?;
+    if primary.origin() != origin(PROFILE_PRIMARY)?.origin() {
+        return None;
+    }
+    let fallback = origin(PROFILE_FALLBACK)?;
+    (primary.origin() != fallback.origin()).then_some((primary, fallback))
+}
+
+pub fn handles(value: &str) -> bool {
+    let Some((primary, _)) = endpoints() else {
+        return false;
+    };
+    let Ok(u) = Url::parse(value) else {
+        return false;
+    };
+    u.origin() == primary.origin()
+        && u.username().is_empty()
+        && u.password().is_none()
+        && u.path().starts_with("/api/")
+}
+
+fn rewrite(value: &str, endpoint: &Url) -> Result<Url, String> {
+    let mut u = Url::parse(value).map_err(|_| "Invalid API URL")?;
+    u.set_host(endpoint.host_str())
+        .map_err(|_| "Invalid API host")?;
+    u.set_port(endpoint.port())
+        .map_err(|_| "Invalid API port")?;
+    Ok(u)
+}
+
+// Configure the user's proxy explicitly, or use a direct client. No environment
+// proxy, TLS cache, certificate bypass, redirects, or raw protocol fallback.
+async fn client(endpoint: &Url, primary: bool) -> Result<Client, String> {
+    client_with_proxy(endpoint, primary, super::api_failover_proxy()?).await
+}
+
+async fn client_with_proxy(
+    endpoint: &Url,
+    primary: bool,
+    proxy: Option<reqwest::Proxy>,
+) -> Result<Client, String> {
+    let started = Instant::now();
+    let mut builder = Client::builder()
+        .no_proxy()
+        .use_rustls_tls()
+        .https_only(true)
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(CONNECT)
+        .timeout(REQUEST);
+    if let Some(proxy) = proxy {
+        // Respect explicit proxy configuration without guessing network type or
+        // rejecting primary in advance. The HTTP library performs proxy DNS/TLS.
+        builder = builder.proxy(proxy);
+    } else if primary {
+        let host = endpoint.host_str().ok_or("Missing API host")?;
+        let port = endpoint.port_or_known_default().ok_or("Missing API port")?;
+        // Url::host_str() retains brackets for IPv6 literals. IP literals do
+        // not go through DNS; their HTTPS certificate still needs an IP SAN.
+        let literal = host
+            .trim_start_matches('[')
+            .trim_end_matches(']')
+            .parse::<std::net::IpAddr>();
+        let addrs: Vec<_> = match literal {
+            Ok(std::net::IpAddr::V6(ip)) => vec![std::net::SocketAddr::new(ip.into(), port)],
+            Ok(std::net::IpAddr::V4(_)) => Vec::new(),
+            Err(_) => tokio::time::timeout(CONNECT, tokio::net::lookup_host((host, port)))
+                .await
+                .map_err(|_| "Primary DNS timeout")?
+                .map_err(|_| "Primary DNS unavailable")?
+                .filter(|addr| addr.is_ipv6())
+                .collect(),
+        };
+        if addrs.is_empty() {
+            return Err("Primary has no IPv6 address".into());
+        }
+        builder = builder.resolve_to_addrs(host, &addrs);
+    }
+    // DNS above and TCP/TLS below share one connection preparation budget.
+    // A small nonzero remainder avoids library-specific zero-timeout semantics.
+    let remaining = CONNECT
+        .checked_sub(started.elapsed())
+        .filter(|remaining| !remaining.is_zero())
+        .ok_or("API connection preparation timeout")?;
+    builder
+        .connect_timeout(remaining)
+        .build()
+        .map_err(|_| "Cannot build strict API client".into())
+}
+
+// Rustls certificate/handshake validation failures are carried as InvalidData
+// io errors by reqwest's connector. Conservatively make all such TLS errors
+// terminal, including negotiation failures we cannot distinguish safely.
+// Never classify by formatted error text (it can include sensitive URLs).
+fn tls_security_error(error: &reqwest::Error) -> bool {
+    let mut source: Option<&(dyn std::error::Error + 'static)> = Some(error);
+    while let Some(error) = source {
+        if let Some(io) = error.downcast_ref::<std::io::Error>() {
+            if io.kind() == std::io::ErrorKind::InvalidData {
+                return true;
+            }
+            // io::Error::source can skip its boxed inner error itself. Inspect
+            // get_ref first to retain nested rustls InvalidData wrappers.
+            source = io
+                .get_ref()
+                .map(|inner| inner as &(dyn std::error::Error + 'static));
+        } else {
+            source = error.source();
+        }
+    }
+    false
+}
+
+// Body failures occur after send() returned headers. They affect only future
+// requests: the current operation is never replayed, regardless of its method.
+pub async fn read_text(value: &str, response: Response) -> Result<String, String> {
+    let (primary, _) = endpoints().ok_or("API failover is not configured")?;
+    if !handles(value) {
+        return Err("URL is outside managed API policy".into());
+    }
+    read_text_for(response, &primary).await
+}
+
+async fn read_text_for(response: Response, primary: &Url) -> Result<String, String> {
+    let was_primary = response.url().origin() == primary.origin();
+    match response.text().await {
+        Ok(text) => Ok(text),
+        Err(_) => {
+            if was_primary {
+                hbb_common::log::warn!(
+                    "API Primary response-body failure; current request not replayed"
+                );
+                unavailable();
+            }
+            Err("API response body failed; outcome unknown, not replayed".into())
+        }
+    }
+}
+
+fn unavailable() {
+    let mut s = state().lock().unwrap();
+    s.generation = s.generation.wrapping_add(1);
+    s.phase = Phase::PrimaryUnavailable;
+    s.retry_at = Some(Instant::now() + COOLDOWN);
+    // Logs contain only endpoint role/reason category, never URL/query/headers/body.
+    hbb_common::log::info!(
+        "API PrimaryUnavailable: transport failure; future requests use fallback"
+    );
+    s.phase = Phase::Fallback;
+}
+
+async fn use_primary(primary: &Url) -> Result<bool, String> {
+    let generation = {
+        let mut s = state().lock().unwrap();
+        if s.phase == Phase::Primary {
+            return Ok(true);
+        }
+        // Expired leases can be reclaimed if a caller cancelled its probe.
+        if matches!(s.phase, Phase::Fallback | Phase::RecoveryProbe)
+            && s.retry_at.is_some_and(|at| Instant::now() >= at)
+        {
+            s.phase = Phase::RecoveryProbe;
+            s.generation = s.generation.wrapping_add(1);
+            s.retry_at = Some(Instant::now() + Duration::from_secs(10));
+            Some(s.generation)
+        } else {
+            None
+        }
+    };
+    if let Some(generation) = generation {
+        let mut primary = primary.clone();
+        primary.set_path("/api/login-options");
+        // No credentials, no body, no redirects, no session restart. Any HTTP
+        // status proves transport reachability; business status is not failover.
+        let probe = match client(&primary, true).await {
+            Ok(c) => match c.head(primary).timeout(CONNECT).send().await {
+                Ok(_) => Ok(true),
+                Err(error) if tls_security_error(&error) => {
+                    hbb_common::log::error!(
+                        "API RecoveryProbe TLS security/negotiation failure; operation stopped"
+                    );
+                    Err("API primary TLS validation/negotiation failed during recovery; operation stopped".to_owned())
+                }
+                Err(_) => Ok(false),
+            },
+            Err(_) => Ok(false),
+        };
+        let ok = matches!(&probe, Ok(true));
+        let mut s = state().lock().unwrap();
+        // A concurrent primary failure may have invalidated this probe.
+        if s.phase == Phase::RecoveryProbe && s.generation == generation {
+            s.phase = if ok { Phase::Primary } else { Phase::Fallback };
+            s.retry_at = Some(Instant::now() + COOLDOWN);
+            hbb_common::log::info!(
+                "API RecoveryProbe: {}",
+                if ok { "Primary" } else { "Fallback" }
+            );
+        }
+        // Publish a bounded lease outcome before propagating security errors;
+        // no business operation from this caller is sent to either endpoint.
+        probe?;
+        return Ok(s.phase == Phase::Primary);
+    }
+    Ok(false)
+}
+
+pub async fn send(
+    value: &str,
+    method: Method,
+    headers: HeaderMap,
+    body: Option<String>,
+) -> Result<Response, String> {
+    if !handles(value) {
+        return Err("URL is outside managed API policy".into());
+    }
+    send_for(
+        endpoints().ok_or("API failover is not configured")?,
+        value,
+        method,
+        headers,
+        body,
+    )
+    .await
+}
+
+async fn send_for(
+    (primary, fallback): (Url, Url),
+    value: &str,
+    method: Method,
+    headers: HeaderMap,
+    body: Option<String>,
+) -> Result<Response, String> {
+    if headers.contains_key(reqwest::header::HOST) {
+        return Err("Explicit API Host header is unsupported".into());
+    }
+    if use_primary(&primary).await? {
+        hbb_common::log::info!(
+            "API endpoint=Primary origin={}",
+            primary.origin().ascii_serialization()
+        );
+        // Client/DNS errors occur before any HTTP request is sent.
+        if let Ok(c) = client(&primary, true).await {
+            let mut req = c
+                .request(method.clone(), rewrite(value, &primary)?)
+                .headers(headers.clone());
+            if let Some(b) = body.as_ref() {
+                req = req.body(b.clone());
+            }
+            match req.send().await {
+                Ok(resp) => return Ok(resp), // 401/403/5xx are never replayed.
+                Err(e) if tls_security_error(&e) => {
+                    hbb_common::log::error!(
+                        "API Primary TLS security/negotiation failure; fallback suppressed"
+                    );
+                    return Err(
+                        "API primary TLS validation/negotiation failed; fallback suppressed".into(),
+                    );
+                }
+                Err(e) if e.is_connect() => {} // HTTP request was not sent.
+                Err(_) => {
+                    unavailable();
+                    return Err("API primary request failed after connection; outcome unknown, not replayed".into());
+                }
+            }
+        }
+        unavailable();
+    }
+    hbb_common::log::info!(
+        "API endpoint=Fallback origin={}",
+        fallback.origin().ascii_serialization()
+    );
+    let c = client(&fallback, false).await?;
+    let mut req = c
+        .request(method, rewrite(value, &fallback)?)
+        .headers(headers);
+    if let Some(b) = body {
+        req = req.body(b);
+    }
+    req.send()
+        .await
+        .map_err(|_| "API fallback request failed; not replayed".into())
+}
+
+// Snapshot the explicit proxy together with the selected endpoint. A proxy's
+// remote_addr is never an origin address and must not be pinned as the backend.
+pub struct RecordingEndpoint {
+    pub url: String,
+    addr: Option<std::net::SocketAddr>,
+    proxy: Option<reqwest::Proxy>,
+}
+impl RecordingEndpoint {
+    pub fn client(&self) -> Result<reqwest::blocking::Client, String> {
+        let mut builder = reqwest::blocking::Client::builder()
+            .no_proxy()
+            .use_rustls_tls()
+            .https_only(true)
+            .redirect(reqwest::redirect::Policy::none())
+            .connect_timeout(CONNECT)
+            .timeout(REQUEST);
+        if let Some(proxy) = self.proxy.clone() {
+            builder = builder.proxy(proxy);
+        } else if let Some(addr) = self.addr {
+            let url = Url::parse(&self.url).map_err(|_| "Invalid recording API URL")?;
+            builder = builder.resolve(url.host_str().ok_or("Missing API host")?, addr);
+        }
+        builder
+            .build()
+            .map_err(|_| "Cannot build strict recording API client".into())
+    }
+}
+
+// This remains a safe HEAD selection followed by a distinct single upload,
+// not connection racing or reuse of the HEAD connection.
+#[tokio::main(flavor = "current_thread")]
+pub async fn recording_endpoint(value: &str) -> Result<RecordingEndpoint, String> {
+    recording_endpoint_for(
+        value,
+        endpoints().ok_or("API failover is not configured")?,
+        super::api_failover_proxy()?,
+    )
+    .await
+}
+
+async fn recording_endpoint_for(
+    value: &str,
+    (mut primary, fallback): (Url, Url),
+    proxy: Option<reqwest::Proxy>,
+) -> Result<RecordingEndpoint, String> {
+    if use_primary(&primary).await? {
+        primary.set_path("/api/login-options");
+        if let Ok(c) = client_with_proxy(&primary, true, proxy.clone()).await {
+            match c.head(primary.clone()).timeout(CONNECT).send().await {
+                Ok(response) => {
+                    let addr = if proxy.is_some() {
+                        None
+                    } else {
+                        response.remote_addr().filter(|addr| addr.is_ipv6())
+                    };
+                    // TLS success through the user's proxy is sufficient; its
+                    // TCP peer family says nothing about the API server family.
+                    if proxy.is_some() || addr.is_some() {
+                        return Ok(RecordingEndpoint {
+                            url: rewrite(value, &primary)?.to_string(),
+                            addr,
+                            proxy,
+                        });
+                    }
+                }
+                Err(error) if tls_security_error(&error) => {
+                    return Err(
+                        "API primary TLS validation/negotiation failed; fallback suppressed".into(),
+                    );
+                }
+                Err(_) => {}
+            }
+        }
+        unavailable();
+    }
+    Ok(RecordingEndpoint {
+        url: rewrite(value, &fallback)?.to_string(),
+        addr: None,
+        proxy,
+    })
+}
