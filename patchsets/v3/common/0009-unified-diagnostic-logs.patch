+            "patchset_version",
+            "upstream_sha",
+            "variant",
+            "build_run",
+            "channel",
+        ] {
+            if let Some(v) = value[key].as_str() {
+                let valid = match key {
+                    "upstream_sha" => v.len() == 40 && v.bytes().all(|b| b.is_ascii_hexdigit()),
+                    "variant" => ["standard", "sos"].contains(&v),
+                    "channel" => ["ci", "stable", "nightly"].contains(&v),
+                    "build_run" => {
