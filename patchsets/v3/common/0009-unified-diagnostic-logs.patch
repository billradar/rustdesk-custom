+                    if job.created.elapsed() < Duration::from_secs(60) =>
+                {
+                    return String::new()
+                }
+                Err(mpsc::TryRecvError::Empty) => Err("diagnostics_timeout".into()),
+                Err(mpsc::TryRecvError::Disconnected) => Err("diagnostics_operation_failed".into()),
+            },
+            None => Err("diagnostics_busy".into()),
+        };
+        jobs.remove(id);
+        match result {
+            Ok(data) => serde_json::json!({"ok":true,"data":data}),
+            Err(code) => serde_json::json!({"ok":false,"error":code}),
+        }
+        .to_string()
+    }
+}
+// No raw URL fields are serialized. Only these closed route names are exposed.
+fn parse_endpoint(value: &str) -> Option<(String, u16, String)> {
+    let (scheme, rest) = value.split_once("://")?;
+    if !["ws", "wss", "http", "https"].contains(&scheme) {
+        return None;
+    }
+    let (authority, path) = rest.split_once('/').unwrap_or((rest, ""));
+    let port = authority
+        .rsplit_once(':')
+        .and_then(|(_, p)| p.parse::<u16>().ok())
+        .unwrap_or(if matches!(scheme, "wss" | "https") {
+            443
+        } else {
+            80
+        });
+    let route = match path {
+        "ws/id" => "id",
+        "ws/relay" => "relay",
+        _ => "other",
+    };
+    Some((scheme.into(), port, route.into()))
+}
+struct RemoveOnDrop(Option<PathBuf>);
+impl Drop for RemoveOnDrop {
+    fn drop(&mut self) {
+        if let Some(path) = &self.0 {
+            let _ = fs::remove_file(path);
+        }
+    }
+}
+struct Store {
+    directory: PathBuf,
+    config: PathBuf,
+    active: Option<(String, File, u64)>,
+    started: Option<Instant>,
+    deadline: Option<Instant>,
+    last_tick: Option<Instant>,
+    config_modified: Option<SystemTime>,
+    elapsed_at_start: u64,
+}
+impl Store {
+    fn new(directory: PathBuf, config: PathBuf) -> Self {
+        Self {
+            directory,
+            config: config.clone(),
+            active: None,
+            started: None,
+            deadline: None,
+            last_tick: None,
+            elapsed_at_start: 0,
+            config_modified: fs::metadata(&config).and_then(|m| m.modified()).ok(),
+        }
+    }
+    fn close(&mut self) {
+        if let Some((_, mut f, _)) = self.active.take() {
+            let _ = f.flush();
+            let _ = f.sync_data();
+        }
+    }
+    fn lock(&self) -> io::Result<File> {
+        private_dir(&self.directory)?;
+        let path = self.directory.join(".writer-lock");
+        if fs::symlink_metadata(&path).is_ok_and(|m| m.file_type().is_symlink()) {
+            return Err(error("unsafe_lock"));
+        }
+        let f = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(path)?;
+        try_exclusive(&f)?;
+        Ok(f)
+    }
+    fn files(&self) -> io::Result<Vec<LogFile>> {
+        let mut files = Vec::new();
+        for entry in fs::read_dir(&self.directory)? {
+            let entry = entry?;
+            let id = entry.file_name().to_string_lossy().into_owned();
+            if valid_id(&id) && entry.file_type()?.is_file() {
+                let file = OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .open(entry.path())?;
+                let active = file.try_lock_exclusive().is_err();
+                files.push(LogFile {
+                    bytes: entry.metadata()?.len(),
+                    pinned: self.directory.join(format!("{id}.keep")).exists(),
+                    id,
+                    active,
+                });
+            }
+        }
+        files.sort_by(|a, b| a.id.cmp(&b.id));
+        Ok(files)
+    }
+    fn persist(
+        &mut self,
+        settings: &Settings,
+        key: &[u8; 32],
+        recording: &str,
+        replace_recording: bool,
+    ) -> io::Result<bool> {
+        // This is deliberately separate from exportable records. No credential/config capture.
+        let lock_path = self.config.with_extension("lock");
+        if fs::symlink_metadata(&lock_path).is_ok_and(|m| m.file_type().is_symlink()) {
+            return Err(error("unsafe_config_lock"));
+        }
+        let lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(lock_path)?;
+        try_exclusive(&lock)?;
+        let mut saved_settings = settings.clone();
+        if !replace_recording {
+            if let Ok(bytes) = fs::read(&self.config) {
+                let current = Persisted::decode(&bytes)?;
+                if current.recording != recording {
+                    return Err(error("diagnostics_busy"));
+                }
+                saved_settings.enabled &= current.settings.enabled;
+            }
+        }
+        let temp = self
+            .config
+            .with_extension(format!("{}.tmp", std::process::id()));
+        let _ = fs::remove_file(&temp);
+        let mut f = private_file(&temp)?;
+        f.write_all(&serde_json::to_vec(&Persisted {
+            settings: saved_settings.clone(),
+            key: *key,
+            recording: recording.to_owned(),
+        })?)?;
+        f.sync_all()?;
