+    /// keep thread-local state across await; unrelated tasks can share a thread.
+    pub fn instrument<F: std::future::Future>(&self, action: Action, future: F) -> Instrumented<F> {
+        Instrumented {
+            context: self.clone(),
+            action,
+            future: Box::pin(future),
+        }
+    }
+    pub fn event(
+        &self,
+        action: Action,
+        module: Module,
+        kind: Kind,
+        code: Code,
+        endpoint: Option<&str>,
+        status: Option<u16>,
+    ) {
+        self.enter(action, || {
+            if let Some(engine) = global() {
+                engine.capture(
+                    if matches!(kind, Kind::Failed) { 1 } else { 2 },
+                    module,
+                    kind,
+                    code,
+                    None,
+                    endpoint,
+                    status,
+                );
+            }
+        });
+    }
+    /// Coalesce high-frequency state evidence (never input/payload content).
+    /// Disabled collection does not consume the slot; at most one per action / 30s.
+    pub fn observe(&self, module: Module, action: Action) {
