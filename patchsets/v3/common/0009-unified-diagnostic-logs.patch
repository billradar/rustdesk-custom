+        let (cx, cr) = mpsc::sync_channel::<Work>(16);
+        let drops = Arc::new(AtomicU64::new(0));
+        let state = shared.clone();
+        let lost = drops.clone();
+        std::thread::Builder::new()
+            .name("radar-diagnostics".into())
+            .spawn(move || {
+                let mut store = Store::new(directory, config);
+                loop {
+                    // Bounded command service avoids starving records under viewer polling.
+                    for _ in 0..4 {
+                        match cr.try_recv() {
+                            Ok(work) => {
+                                let result =
+                                    store.command(work.command, &state).map_err(public_error);
+                                let _ = work.reply.send(result);
+                            }
+                            Err(_) => break,
+                        }
+                    }
+                    store.tick(&state, &lost);
+                    match rx.recv_timeout(Duration::from_millis(100)) {
+                        Ok(event) => {
+                            if let Err(e) = store.write(event, &state) {
+                                if e.kind() == io::ErrorKind::WouldBlock {
+                                    lost.fetch_add(1, Ordering::Relaxed);
+                                    continue;
+                                }
