+        }
+        let (sender, receiver) = mpsc::channel();
+        engine.jobs.lock().unwrap().insert(
+            "abc".into(),
+            Job {
+                created: Instant::now(),
+                receiver,
+            },
+        );
+        let state = engine.shared.lock().unwrap();
+        let start = Instant::now();
+        assert!(engine.poll("abc").is_empty());
+        assert!(start.elapsed() < Duration::from_millis(100));
+        drop(state);
+        drop(sender);
+        assert!(!engine.poll("abc").is_empty());
+        engine.begin("abc",serde_json::json!({"op":"configure","settings":Settings {enabled:true,..Settings::default()}})).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(5);
+        loop {
