+            key,
+            recording: saved.recording,
+            build: serde_json::json!({}),
+        }));
+        let (tx, rx) = mpsc::sync_channel(1024);
+        let (cx, cr) = mpsc::sync_channel::<Work>(16);
+        let drops = Arc::new(AtomicU64::new(0));
+        let state = shared.clone();
+        let lost = drops.clone();
+        std::thread::Builder::new()
+            .name("radar-diagnostics".into())
+            .spawn(move || {
+                let mut store = Store::new(directory, config);
+                loop {
+                    // Bounded command service avoids starving records under viewer polling.
+                    for _ in 0..4 {
+                        match cr.try_recv() {
+                            Ok(work) => {
+                                let result =
+                                    store.command(work.command, &state).map_err(public_error);
+                                let _ = work.reply.send(result);
+                            }
+                            Err(_) => break,
+                        }
+                    }
+                    store.tick(&state, &lost);
+                    match rx.recv_timeout(Duration::from_millis(100)) {
+                        Ok(event) => {
+                            if let Err(e) = store.write(event, &state) {
+                                if e.kind() == io::ErrorKind::WouldBlock {
+                                    lost.fetch_add(1, Ordering::Relaxed);
+                                    continue;
+                                }
+                                let mut s = state.lock().unwrap();
+                                s.status.state = "error".into();
+                                s.status.error = Some(
+                                    match (e.kind(), e.to_string().as_str()) {
+                                        (_, "quota_protected") => "protected_logs_fill_quota",
+                                        (io::ErrorKind::PermissionDenied, _) => "permission_denied",
+                                        _ => "storage_unavailable",
+                                    }
+                                    .into(),
+                                );
+                                s.settings.enabled = false;
+                                let _ = store.persist(&s.settings, &s.key, &s.recording, false);
+                                store.close();
+                            }
+                        }
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                    }
+                }
+            })?;
+        Ok(Self {
+            shared,
+            events: tx,
+            commands: cx,
+            drops,
+            jobs: Mutex::new(HashMap::new()),
+        })
+    }
+    pub fn set_build(&self, value: &serde_json::Value) {
+        let mut safe = serde_json::Map::new();
+        for key in [
+            "version",
+            "revision",
+            "patchset_version",
+            "upstream_sha",
+            "variant",
+            "build_run",
+            "channel",
+        ] {
+            if let Some(v) = value[key].as_str() {
+                let valid = match key {
+                    "upstream_sha" => v.len() == 40 && v.bytes().all(|b| b.is_ascii_hexdigit()),
+                    "variant" => ["standard", "sos"].contains(&v),
+                    "channel" => ["ci", "stable", "nightly"].contains(&v),
+                    "build_run" => {
+                        !v.is_empty() && v.len() <= 20 && v.bytes().all(|b| b.is_ascii_digit())
+                    }
+                    _ => {
+                        !v.is_empty()
+                            && v.len() <= 40
+                            && v.bytes()
+                                .all(|b| b.is_ascii_digit() || b == b'.' || b == b'v')
