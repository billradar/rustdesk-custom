+    #[test]
+    fn async_context_isolated_across_pending_migration_cancel_and_unwind() {
+        use std::future::{poll_fn, Future};
+        use std::task::{Context, Poll, Wake, Waker};
+        struct NoWake;
+        impl Wake for NoWake {
+            fn wake(self: Arc<Self>) {}
+        }
+        fn active() -> Option<(String, Action)> {
+            ACTIVE_CONTEXT.with(|slot| {
+                slot.borrow()
+                    .as_ref()
+                    .map(|v| (v.context.0.id.clone(), v.action))
+            })
+        }
+        let a = DiagnosticContext::new();
+        let b = DiagnosticContext::new();
+        assert_ne!(a.0.id, b.0.id);
+        let expected_a = a.0.id.clone();
+        let expected_b = b.0.id.clone();
+        let mut polls = 0;
+        let mut first = a.instrument(
+            Action::SessionConnect,
+            poll_fn(move |_| {
+                assert_eq!(active(), Some((expected_a.clone(), Action::SessionConnect)));
+                polls += 1;
+                if polls == 1 {
+                    Poll::Pending
+                } else {
+                    Poll::Ready(17)
+                }
+            }),
+        );
+        let mut second = b.instrument(
+            Action::ApiRequest,
+            poll_fn(move |_| {
+                assert_eq!(active(), Some((expected_b.clone(), Action::ApiRequest)));
+                Poll::<()>::Pending
+            }),
+        );
+        let waker = Waker::from(Arc::new(NoWake));
+        let mut cx = Context::from_waker(&waker);
+        assert!(std::pin::Pin::new(&mut first).poll(&mut cx).is_pending());
+        assert!(active().is_none());
+        a.enter(Action::VideoDecode, || {
+            assert!(std::pin::Pin::new(&mut second).poll(&mut cx).is_pending());
+            assert_eq!(active(), Some((a.0.id.clone(), Action::VideoDecode)));
+        });
+        drop(second);
+        assert!(active().is_none());
+        // The same pending future may move to a different executor thread.
+        std::thread::spawn(move || {
+            assert!(active().is_none());
+            let waker = Waker::from(Arc::new(NoWake));
+            let mut cx = Context::from_waker(&waker);
+            assert_eq!(
+                std::pin::Pin::new(&mut first).poll(&mut cx),
+                Poll::Ready(17)
+            );
+            assert!(active().is_none());
+        })
+        .join()
+        .unwrap();
+        let result =
+            std::panic::catch_unwind(|| a.enter(Action::ClipboardSync, || panic!("test unwind")));
+        assert!(result.is_err());
+        assert!(active().is_none());
+    }
