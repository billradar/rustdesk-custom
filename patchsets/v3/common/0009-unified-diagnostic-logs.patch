+pub enum Kind {
+    Started,
+    Stopped,
+    Changed,
+    Attempt,
+    Connected,
+    Failed,
+    Disconnected,
+    Upgrade,
+    LegacyEvent,
+    Overflow,
+    Completed,
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
