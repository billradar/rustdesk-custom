+            id: hex(&rand::random::<[u8; 16]>()),
+            activity: std::array::from_fn(|_| AtomicU64::new(0)),
+        }))
+    }
+    pub fn current_or_new() -> Self {
+        ACTIVE_CONTEXT
+            .with(|slot| slot.borrow().as_ref().map(|v| v.context.clone()))
+            .unwrap_or_default()
+    }
+    pub fn enter<T>(&self, action: Action, f: impl FnOnce() -> T) -> T {
+        let previous = ACTIVE_CONTEXT.with(|slot| {
+            slot.replace(Some(ActiveContext {
+                context: self.clone(),
+                action,
+            }))
+        });
+        let _restore = RestoreContext(previous);
+        f()
+    }
