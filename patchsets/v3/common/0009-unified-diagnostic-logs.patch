+/// Random local connection-attempt identity. Never derived from peer ID, token or key.
+#[derive(Clone)]
+pub struct DiagnosticContext(Arc<ContextData>);
+struct ContextData {
+    id: String,
+    activity: [AtomicU64; Action::AppLifecycle as usize + 1],
+}
+#[derive(Clone)]
+struct ActiveContext {
+    context: DiagnosticContext,
+    action: Action,
+}
+thread_local! {
+    static ACTIVE_CONTEXT: std::cell::RefCell<Option<ActiveContext>> = const { std::cell::RefCell::new(None) };
+}
+struct RestoreContext(Option<ActiveContext>);
+impl Drop for RestoreContext {
+    fn drop(&mut self) {
+        ACTIVE_CONTEXT.with(|slot| {
+            slot.replace(self.0.take());
+        });
+    }
+}
+impl Default for DiagnosticContext {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+impl DiagnosticContext {
