+        let ready = directory.join(format!(".ready-{}", std::process::id()));
+        drop(private_file(&ready).unwrap());
+        let deadline = Instant::now() + Duration::from_secs(5);
+        while !directory.join(".go").exists() && Instant::now() < deadline {
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        assert!(
+            directory.join(".go").exists(),
+            "parent must release the start barrier"
+        );
+        let mut written = 0;
+        let mut dropped = 0;
+        for _ in 0..4000 {
+            let mut event = event();
+            event.process = std::process::id();
+            match store.write(event, &state) {
+                Ok(()) => written += 1,
+                Err(e) if e.kind() == io::ErrorKind::WouldBlock => {
+                    dropped += 1;
+                    std::thread::sleep(Duration::from_millis(1));
+                }
+                Err(e) => panic!("writer failed: {e}"),
+            }
+        }
+        assert!(written > 0, "each process must make forward progress");
+        assert_eq!(written + dropped, 4000);
+        println!(
+            "process {} wrote {written}, contention drops {dropped}",
+            std::process::id()
+        );
+        store.close();
+    }
