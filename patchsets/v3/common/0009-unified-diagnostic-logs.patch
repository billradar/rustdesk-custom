+                    level: u8,
+                    module: Module,
+                    kind: Kind,
+                    code: Code,
+                    #[serde(default)]
+                    action: Option<Action>,
+                    #[serde(default)]
+                    session: Option<String>,
+                    #[serde(default)]
+                    endpoint: Option<String>,
+                    #[serde(default)]
+                    status: Option<u16>,
