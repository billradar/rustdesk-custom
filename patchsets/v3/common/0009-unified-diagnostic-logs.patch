+            Command::Start(settings) => self.configure(settings, true, shared),
+            Command::Stop => {
+                let mut settings = shared.lock().unwrap().settings.clone();
+                settings.enabled = false;
+                {
+                    let s = shared.lock().unwrap();
+                    self.persist(&settings, &s.key, &s.recording, false)?;
+                }
+                let elapsed = self.elapsed();
+                self.close();
+                self.deadline = None;
+                let mut state = shared.lock().unwrap();
+                state.settings = settings;
+                state.status.elapsed_seconds = elapsed;
+                state.status.remaining_seconds = None;
+                state.status.state = "stopped".into();
+                Ok(serde_json::json!(true))
+            }
