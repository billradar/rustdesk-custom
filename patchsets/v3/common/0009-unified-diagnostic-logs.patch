diff --git a/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/DiagnosticLog.kt b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/DiagnosticLog.kt
new file mode 100644
--- /dev/null
+++ b/flutter/android/app/src/main/kotlin/com/carriez/flutter_hbb/DiagnosticLog.kt
@@ -0,0 +1,20 @@
+package com.carriez.flutter_hbb
+
+/** Typed metadata adapter. Never format message, tag, throwable or stack to storage. */
+@androidx.annotation.Keep
+object DiagnosticLog {
+    @androidx.annotation.Keep
+    private external fun nativeEvent(level: Int)
+    private fun event(level: Int): Int {
+        try { nativeEvent(level) } catch (_: UnsatisfiedLinkError) { /* Rust not loaded yet. */ }
+        when (level) {
+            1 -> android.util.Log.e("RadarDiagnostics", "Native error (details omitted)")
+            2 -> android.util.Log.w("RadarDiagnostics", "Native warning (details omitted)")
+            else -> android.util.Log.d("RadarDiagnostics", "Native diagnostic event (details omitted)")
+        }
+        return 0
+    }
+    @Suppress("UNUSED_PARAMETER") fun d(tag: String?, message: String?, error: Throwable? = null): Int = event(3)
+    @Suppress("UNUSED_PARAMETER") fun w(tag: String?, message: String?, error: Throwable? = null): Int = event(2)
+    @Suppress("UNUSED_PARAMETER") fun e(tag: String?, message: String?, error: Throwable? = null): Int = event(1)
+}
