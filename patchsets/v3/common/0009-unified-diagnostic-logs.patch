+            Ok(bytes) => Persisted::decode(&bytes)?,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => Persisted::new(Settings::default()),
+            Err(_) => return Err(error("settings_unreadable")),
+        };
+        let mut settings = saved.settings;
+        settings.validate()?;
+        // Restart can resume only the previously saved absolute end, never a fresh duration.
+        if settings.enabled
+            && settings
+                .active_until_utc
+                .or(settings.end_utc)
+                .is_some_and(|v| now() >= v)
+        {
+            settings.enabled = false;
+        }
