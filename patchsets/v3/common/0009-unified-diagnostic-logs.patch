+    fn typed_context_is_pseudonymized_before_enqueue_and_old_schema_still_reads() {
+        let (_temp, mut store, state) = fixture();
+        let (events, rx) = mpsc::sync_channel(8);
+        let (commands, _cr) = mpsc::sync_channel(1);
+        let engine = Engine {
+            shared: Arc::new(state),
+            events,
+            commands,
+            drops: Arc::new(AtomicU64::new(0)),
+            jobs: Mutex::new(HashMap::new()),
+        };
+        let first = DiagnosticContext::new();
+        let other = DiagnosticContext::new();
+        for context in [&first, &first, &other] {
+            context.enter(Action::ApiRequest, || {
+                engine.capture(
+                    2,
+                    Module::Api,
+                    Kind::Completed,
+                    Code::None,
+                    None,
+                    Some("https://user:SECRET@private.invalid/api/login?token=SECRET"),
+                    Some(401),
+                )
+            });
+        }
+        let a = rx.recv().unwrap();
+        let b = rx.recv().unwrap();
+        let c = rx.recv().unwrap();
+        assert_eq!(a.session, b.session);
+        assert_ne!(a.session, c.session);
+        assert_eq!(a.action, Some(Action::ApiRequest));
+        assert_eq!(a.status, Some(401));
+        let serialized = serde_json::to_string(&a).unwrap();
+        for secret in ["SECRET", "private.invalid", "user:", &first.0.id] {
+            assert!(!serialized.contains(secret));
+        }
+        validate_event(&a).unwrap();
+        write_record(&mut store, &engine.shared);
+        // Viewer/export decode old records without action; unknown actions/payloads fail closed.
+        let mut value = serde_json::to_value(&a).unwrap();
+        value.as_object_mut().unwrap().remove("action");
+        assert!(serde_json::from_value::<Event>(value.clone()).is_ok());
+        value["action"] = serde_json::json!("password=SECRET");
+        assert!(serde_json::from_value::<Event>(value).is_err());
+        assert!(engine.request(serde_json::json!({"op":"event","event":{"level":2,"module":"api","kind":"completed","code":"none","action":"api_request","password":"SECRET"}})).is_err());
+        // New recording key prevents correlation between independent recordings.
+        engine.shared.lock().unwrap().key = [9; 32];
+        first.enter(Action::ApiRequest, || {
+            engine.capture(
+                2,
+                Module::Api,
+                Kind::Completed,
+                Code::None,
+                None,
+                None,
+                None,
+            )
+        });
+        assert_ne!(a.session, rx.recv().unwrap().session);
+    }
