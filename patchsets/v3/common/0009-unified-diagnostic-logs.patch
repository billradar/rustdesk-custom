+                                s.status.state = "error".into();
+                                s.status.error = Some(
+                                    match (e.kind(), e.to_string().as_str()) {
+                                        (_, "quota_protected") => "protected_logs_fill_quota",
+                                        (io::ErrorKind::PermissionDenied, _) => "permission_denied",
+                                        _ => "storage_unavailable",
+                                    }
+                                    .into(),
+                                );
+                                s.settings.enabled = false;
+                                let _ = store.persist(&s.settings, &s.key, &s.recording, false);
+                                store.close();
+                            }
+                        }
+                        Err(mpsc::RecvTimeoutError::Disconnected) => break,
+                        Err(mpsc::RecvTimeoutError::Timeout) => {}
+                    }
+                }
+            })?;
+        Ok(Self {
+            shared,
+            events: tx,
+            commands: cx,
+            drops,
+            jobs: Mutex::new(HashMap::new()),
+        })
+    }
+    pub fn set_build(&self, value: &serde_json::Value) {
