+    pub fn lifetime(&self, module: Module, action: Action) -> Lifetime {
+        self.event(action, module, Kind::Started, Code::None, None, None);
+        Lifetime {
+            context: self.clone(),
+            module,
+            action,
+        }
+    }
+}
+pub struct Instrumented<F: std::future::Future> {
+    context: DiagnosticContext,
+    action: Action,
+    future: std::pin::Pin<Box<F>>,
+}
+impl<F: std::future::Future> std::future::Future for Instrumented<F> {
+    type Output = F::Output;
+    fn poll(
+        self: std::pin::Pin<&mut Self>,
+        cx: &mut std::task::Context<'_>,
+    ) -> std::task::Poll<Self::Output> {
+        let this = self.get_mut();
+        this.context
+            .enter(this.action, || this.future.as_mut().poll(cx))
+    }
+}
+pub struct Lifetime {
+    context: DiagnosticContext,
+    module: Module,
+    action: Action,
+}
+impl Drop for Lifetime {
+    fn drop(&mut self) {
+        self.context.event(
+            self.action,
+            self.module,
+            Kind::Stopped,
+            Code::None,
+            None,
+            None,
+        );
+    }
+}
