diff --git a/flutter/lib/common/diagnostic_events.dart b/flutter/lib/common/diagnostic_events.dart
new file mode 100644
--- /dev/null
+++ b/flutter/lib/common/diagnostic_events.dart
@@ -0,0 +1,33 @@
+import 'dart:ui';
+import 'package:flutter/foundation.dart';
+import 'diagnostic_rpc.dart';
+
+bool _installed = false;
+bool _pending = false;
+
+/// One in-flight bridge event, no raw message/exception/stack crosses the boundary.
+void diagnosticEvent({int level = 3, String kind = 'legacy_event', String code = 'none'}) {
+  if (_pending) return;
+  _pending = true;
+  () async {
+    try {
+      await diagnosticRpc({'op':'event','event':{'level':level,'module':'flutter','kind':kind,'code':code}});
+    } catch (_) {
+      // FFI may not yet be initialized during startup; never recursively log failures.
+    } finally { _pending = false; }
+  }();
+}
+
+void installDiagnosticHooks() {
+  if (_installed) return;
+  _installed = true;
+  debugPrint = (String? message, {int? wrapWidth}) { diagnosticEvent(); };
+  FlutterError.onError = (details) {
+    diagnosticEvent(level:1,kind:'failed',code:'unknown');
+    FlutterError.presentError(FlutterErrorDetails(exception: StateError('Diagnostic error (details omitted)')));
+  };
+  PlatformDispatcher.instance.onError = (error, stack) {
+    diagnosticEvent(level:1,kind:'failed',code:'unknown');
+    return false; // Preserve the platform's necessary uncaught-error handling.
+  };
+}
diff --git a/flutter/lib/common/diagnostic_rpc.dart b/flutter/lib/common/diagnostic_rpc.dart
new file mode 100644
--- /dev/null
+++ b/flutter/lib/common/diagnostic_rpc.dart
@@ -0,0 +1,20 @@
+import 'dart:async';
+import 'dart:convert';
+import 'package:flutter/foundation.dart';
+import 'package:uuid/uuid.dart';
+import '../models/platform_model.dart';
+
+/// Reuse the original bridge ABI. Requests are intercepted before option persistence.
+/// The async setter queues work; the synchronous getter only polls memory.
+Future<dynamic> diagnosticRpc(Map<String, dynamic> request) async {
+  if (kIsWeb) return {'ok':false,'error':'unsupported_platform'};
+  final id=const Uuid().v4();
+  await bind.mainSetLocalOption(key:'radar-diagnostic-request:$id',value:jsonEncode(request));
+  final watch=Stopwatch()..start();
+  while (watch.elapsed < const Duration(seconds: 60)) {
+    final result=bind.mainGetLocalOption(key:'radar-diagnostic-result:$id');
+    if(result.isNotEmpty)return jsonDecode(result);
+    await Future<void>.delayed(const Duration(milliseconds:50));
+  }
+  return {'ok':false,'error':'diagnostics_timeout'};
+}
diff --git a/flutter/lib/common/widgets/logs_page.dart b/flutter/lib/common/widgets/logs_page.dart
new file mode 100644
--- /dev/null
+++ b/flutter/lib/common/widgets/logs_page.dart
@@ -0,0 +1,180 @@
+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import '../../common.dart';
+import '../../models/model.dart';
+import '../diagnostic_rpc.dart';
+
+class DiagnosticFailure implements Exception {
+  final String code;
+  DiagnosticFailure(this.code);
+}
+
+/// Shared desktop/mobile settings. No raw application output is imported.
+class LogsPage extends StatefulWidget {
+  const LogsPage({Key? key}) : super(key: key);
+  @override
+  State<LogsPage> createState() => _LogsPageState();
+}
+
+class _LogsPageState extends State<LogsPage> {
+  Map<String, dynamic>? _settings;
+  Map<String, dynamic> _status = {}, _build = {};
+  List<dynamic> _files = [], _rows = [];
+  final Set<String> _selected = {};
+  final _search = TextEditingController();
+  Timer? _timer;
+  bool _busy = false, _polling = false;
+  String? _error;
+  int? _filterLevel;
+  String? _filterModule;
+  DateTime? _after;
+  int _offset = 0;
+  String t(String en, String zh) =>
+      Localizations.localeOf(context).languageCode == 'zh' ? zh : en;
+
+  Future<dynamic> _request(Map<String, dynamic> request) async {
+    final decoded = await diagnosticRpc(request);
+    if (decoded['ok'] != true) throw DiagnosticFailure(decoded['error'] as String? ?? 'diagnostics_failed');
+    return decoded['data'];
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    _refresh();
+    _timer = Timer.periodic(const Duration(seconds: 2), (_) => _refresh());
+  }
+  @override
+  void dispose() { _timer?.cancel(); _search.dispose(); super.dispose(); }
+
+  Future<void> _refresh() async {
+    if (_polling || _busy) return;
+    _polling = true;
+    try {
+      final value = await _request({'op':'status'});
+      if (!mounted) return;
+      setState(() { _status = Map<String,dynamic>.from(value['status']); _build = Map<String,dynamic>.from(value['build']??{}); _settings ??= Map<String,dynamic>.from(value['settings']); });
+    } catch (_) { if (mounted) setState(() => _error = 'diagnostics_unavailable'); }
+    finally { _polling = false; }
+  }
+
+  Future<void> _run(Future<void> Function() action) async {
+    if (_busy) return;
+    setState(() { _busy=true; _error=null; });
+    try { await action(); }
+    catch (error) { if (mounted) setState(() => _error = error is DiagnosticFailure ? _failure(error.code) : t('Operation failed. Check directory permissions and settings. No raw error details are exported.', '操作失败，请检查目录权限及配置。不会导出原始错误详情。')); }
+    finally { if (mounted) {setState(() => _busy=false); await _refresh();} }
+  }
+  String _failure(String code) {
+    final messages={
+      'protected_logs_fill_quota':t('Protected logs fill the storage limit. Release a kept log or increase the limit, then restart recording.','受保护日志已占满容量，请解除部分保留或提高上限，然后重新开启记录。'),
+      'storage_unavailable':t('Storage is unavailable. Check the directory or choose the default location.','存储不可用，请检查目录或选择默认目录。'),
+      'export_requires_storage_budget':t('Export needs temporary space within the total limit. Select fewer logs, clean up or increase the limit.','导出需要总容量上限内的临时空间。请减少所选文件、清理日志或提高总容量。'),
+      'export_disk_space':t('Insufficient free disk space for export.','磁盘剩余空间不足，无法导出。'),
+      'invalid_settings':t('Invalid settings: check the size limits, level and duration.','配置无效，请检查大小上限、等级和时长。'),
+      'invalid_schedule':t('Invalid schedule: the end must follow the start.','时间配置无效，结束时间必须晚于开始时间。'),
+      'permission_denied':t('Directory permission denied. Choose the default directory or grant access again.','目录权限不足，请选择默认目录或重新授权。'),
+      'diagnostics_busy':t('Logs are busy. Try again shortly.','日志正在处理其他操作，请稍后重试。'),
+      'active_or_missing_file':t('A selected log is active in another process or no longer exists. Refresh the list.','所选日志正在其他进程写入或已不存在，请刷新列表。'),
+      'corrupt_record':t('A log is damaged. Exclude it from export; raw data will not be copied.','日志文件损坏，请排除该文件后导出，不会复制原始数据。'),
+    };
+    return messages[code]??t('Diagnostic operation failed. No raw error details are exported.','日志操作失败，不会导出原始错误详情。');
+  }
+  Future<void> _save({bool? enabled}) async {
+    final next = Map<String,dynamic>.from(_settings!);
+    if (enabled != null) next['enabled']=enabled;
+    await _request({'op':'configure','settings':next});
+    final value = await _request({'op':'status'});
+    if (mounted) setState(() => _settings=Map<String,dynamic>.from(value['settings']));
+  }
+  Future<int?> _number(String title, int value) async {
+    final input=TextEditingController(text:'$value');
+    final result=await showDialog<int>(context:context,builder:(context)=>AlertDialog(
+      title:Text(title),content:TextField(controller:input,keyboardType:TextInputType.number),
+      actions:[TextButton(onPressed:()=>Navigator.pop(context),child:Text(t('Cancel','取消'))),TextButton(onPressed:(){final n=int.tryParse(input.text);if(n!=null&&n>0)Navigator.pop(context,n);},child:Text(t('OK','确定')))]));
+    input.dispose();return result;
