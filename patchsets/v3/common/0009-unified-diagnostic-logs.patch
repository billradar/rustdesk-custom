+                                .expect("validated timestamp")
+                                < *v
+                        }) || query.level.is_some_and(|v| event.level > v)
+                            || query.module.is_some_and(|v| {
+                                std::mem::discriminant(&event.module) != std::mem::discriminant(&v)
+                            })
+                            || query.keyword.as_ref().is_some_and(|v| !text.contains(v))
+                        {
+                            return Ok(true);
+                        }
+                        if skip > 0 {
+                            skip -= 1;
+                            return Ok(true);
+                        }
+                        rows.push(event);
+                        Ok(rows.len() != MAX_QUERY)
+                    })?;
+                    if rows.len() == MAX_QUERY {
+                        break;
+                    }
+                }
+                Ok(serde_json::to_value(rows)?)
+            }
+            Command::Export(ids) => {
+                if ids.is_empty() || ids.len() > 1000 || ids.iter().any(|id| !valid_id(id)) {
+                    return Err(error("invalid_selection"));
+                }
+                self.close();
+                let config_lock = OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .create(true)
+                    .truncate(false)
+                    .open(self.config.with_extension("lock"))?;
+                try_exclusive(&config_lock)?;
+                let _lock = self.lock()?;
+                let files = self.files()?;
+                let exports = self.config.parent().unwrap().join("exports");
+                private_dir(&exports)?;
+                let metadata = serde_json::to_vec(
+                    &serde_json::json!({"schema":1,"privacy":"typed-events-only","automatic_upload":false,"build":shared.lock().unwrap().build,"platform":std::env::consts::OS,"architecture":std::env::consts::ARCH}),
+                )?;
+                let mut sizes = Vec::new();
+                let mut archive_size = 1024 + 512 + ((metadata.len() as u64 + 511) / 512) * 512;
+                for id in &ids {
+                    if !files.iter().any(|f| f.id == *id && !f.active) {
+                        return Err(error("active_or_missing_file"));
+                    }
+                    let mut size = 0;
+                    visit_records(&self.directory.join(id), |e| {
+                        size += serde_json::to_vec(&e)?.len() as u64 + 1;
+                        Ok(true)
+                    })?;
+                    sizes.push(size);
+                    archive_size += 512 + ((size + 511) / 512) * 512;
+                }
+                // Temporary archives are part of the configured storage cap. Never exceed
+                // it to export; the user can select fewer files, clean up or raise the cap.
+                self.clean_exports()?;
+                let used: u64 = files.iter().map(|f| f.bytes).sum::<u64>() + self.export_bytes()?;
+                let limit = shared.lock().unwrap().settings.total_bytes;
+                if used.saturating_add(archive_size) > limit {
+                    return Err(error("export_requires_storage_budget"));
+                }
+                if fs2::available_space(&exports)? < archive_size.saturating_add(MB) {
+                    return Err(error("export_disk_space"));
+                }
+                let path = exports.join(format!(
+                    "diagnostics-{}.tar",
+                    hex(&rand::random::<[u8; 16]>())
+                ));
+                let mut cleanup = RemoveOnDrop(Some(path.clone()));
+                let file = private_file(&path)?;
+                try_exclusive(&file)?;
+                let mut archive = tar::Builder::new(file);
+                for (id, size) in ids.into_iter().zip(sizes) {
+                    let mut header = tar::Header::new_gnu();
+                    header.set_size(size);
+                    header.set_mode(0o600);
+                    header.set_cksum();
+                    archive.append_data(
+                        &mut header,
+                        &id,
+                        ValidatedReader::new(&self.directory.join(&id))?,
+                    )?;
+                }
+                let mut header = tar::Header::new_gnu();
+                header.set_size(metadata.len() as u64);
+                header.set_mode(0o600);
+                header.set_cksum();
+                archive.append_data(&mut header, "metadata.json", metadata.as_slice())?;
+                archive.finish()?;
+                archive.into_inner()?.sync_all()?;
+                cleanup.0 = None;
+                Ok(serde_json::json!({"path":path}))
+            }
+        }
+    }
+    fn export_files(&self) -> io::Result<Vec<(PathBuf, u64, SystemTime, bool)>> {
+        let directory = self.config.parent().unwrap().join("exports");
+        if !directory.exists() {
+            return Ok(Vec::new());
+        }
+        let mut result = Vec::new();
+        for entry in fs::read_dir(directory)? {
+            let entry = entry?;
+            let name = entry.file_name().to_string_lossy().into_owned();
+            if !name.starts_with("diagnostics-")
+                || !name.ends_with(".tar")
+                || name.len() != 48
+                || !entry.file_type()?.is_file()
+            {
+                continue;
+            }
+            let file = OpenOptions::new()
+                .read(true)
+                .write(true)
+                .open(entry.path())?;
+            result.push((
+                entry.path(),
+                entry.metadata()?.len(),
+                entry.metadata()?.modified()?,
+                try_exclusive(&file).is_err(),
+            ));
+        }
+        Ok(result)
+    }
+    fn export_bytes(&self) -> io::Result<u64> {
+        Ok(self.export_files()?.iter().map(|v| v.1).sum())
+    }
+    fn clean_exports(&self) -> io::Result<()> {
+        for (path, _, modified, active) in self.export_files()? {
+            if !active
+                && SystemTime::now()
+                    .duration_since(modified)
+                    .is_ok_and(|v| v.as_secs() > 86400)
+            {
+                fs::remove_file(path)?;
+            }
+        }
+        Ok(())
+    }
+    fn tick(&mut self, shared: &Mutex<Shared>, drops: &AtomicU64) {
+        if self
+            .last_tick
+            .is_some_and(|v| v.elapsed() < Duration::from_secs(1))
+        {
+            return;
+        }
+        self.last_tick = Some(Instant::now());
+        let modified = fs::metadata(&self.config).and_then(|m| m.modified()).ok();
+        let mut s = shared.lock().unwrap();
+        if modified.is_some() && modified != self.config_modified {
+            if let Ok(bytes) = fs::read(&self.config) {
+                if let Ok(saved) = Persisted::decode(&bytes) {
+                    {
+                        let settings = saved.settings;
+                        self.close();
+                        self.directory = settings
+                            .directory
+                            .clone()
+                            .unwrap_or_else(|| self.config.parent().unwrap().join("records"));
+                        self.started = None;
+                        self.deadline = None;
+                        s.settings = settings;
+                        s.key = saved.key;
+                        s.recording = saved.recording;
+                        s.status.error = None;
+                        self.config_modified = modified;
+                    }
+                }
+            }
+        }
+        let current = now();
+        if !s.settings.enabled {
+            self.close();
+            if s.status.error.is_some() {
+                s.status.state = "error".into();
+                return;
+            }
+            s.status.state = if self.started.is_some() {
+                "stopped"
+            } else {
+                "off"
+            }
+            .into();
+        } else if s
+            .settings
+            .active_until_utc
+            .or(s.settings.end_utc)
+            .is_some_and(|v| current >= v)
+            || self.deadline.is_some_and(|v| Instant::now() >= v)
+        {
+            self.close();
+            s.settings.enabled = false;
+            s.status.state = "stopped".into();
+            let _ = self.persist(&s.settings, &s.key, &s.recording, false);
+        } else if s.settings.start_utc.is_some_and(|v| current < v) && self.started.is_none() {
+            s.status.state = "waiting".into();
+        } else {
+            if self.started.is_none() {
+                self.started = Some(Instant::now());
+                self.elapsed_at_start = s
+                    .settings
+                    .active_started_utc
+                    .map(|v| current.saturating_sub(v).max(0) as u64)
+                    .unwrap_or(0);
+                self.deadline = s.settings.active_until_utc.or(s.settings.end_utc).map(|v| {
+                    Instant::now() + Duration::from_secs(v.saturating_sub(current) as u64)
+                });
+            }
+            s.status.state = "recording".into();
+        }
+        s.status.elapsed_seconds = self
+            .started
+            .map(|v| v.elapsed().as_secs().saturating_add(self.elapsed_at_start))
+            .unwrap_or(0);
+        s.status.remaining_seconds = self
+            .deadline
+            .map(|v| v.saturating_duration_since(Instant::now()).as_secs());
+        s.status.dropped = drops.load(Ordering::Relaxed);
+        s.status.current_bytes = self.active.as_ref().map(|v| v.2).unwrap_or(0);
+        s.status.directory = self.directory.clone();
+        // Disk enumeration is worker-only and never on producer/UI threads.
+        if let Ok(_lock) = self.lock() {
+            if let Ok(files) = self.files() {
+                let mut total: u64 =
+                    files.iter().map(|v| v.bytes).sum::<u64>() + self.export_bytes().unwrap_or(0);
+                for f in &files {
+                    let path = self.directory.join(&f.id);
+                    let expired = s.settings.retention_days.is_some_and(|days| {
+                        path.metadata()
+                            .and_then(|m| m.modified())
+                            .ok()
+                            .and_then(|v| SystemTime::now().duration_since(v).ok())
+                            .is_some_and(|age| age.as_secs() > days as u64 * 86400)
+                    });
+                    if !f.active
+                        && !f.pinned
+                        && (expired || total > s.settings.total_bytes)
+                        && fs::remove_file(path).is_ok()
+                    {
+                        total = total.saturating_sub(f.bytes);
+                    }
+                }
+                s.status.total_bytes = total;
+                s.status.export_bytes = self.export_bytes().unwrap_or(0);
+                let _ = self.clean_exports();
+                s.status.files = self.files().map(|v| v.len()).unwrap_or(files.len());
+            }
+        }
+    }
+    fn write(&mut self, event: Event, shared: &Mutex<Shared>) -> io::Result<()> {
+        let s = shared.lock().unwrap();
+        if s.status.state != "recording"
+            || !s.settings.enabled
+            || event.recording != s.recording
+            || event.level > s.settings.level
+        {
+            return Ok(());
+        }
+        let settings = s.settings.clone();
+        drop(s);
+        let mut data = serde_json::to_vec(&event)?;
+        data.push(b'\n');
+        if data.len() > MAX_RECORD {
+            return Err(error("record_too_large"));
+        }
+        let config_lock = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create(true)
+            .truncate(false)
+            .open(self.config.with_extension("lock"))?;
+        try_exclusive(&config_lock)?;
+        let _lock = self.lock()?;
+        if self
+            .active
+            .as_ref()
+            .is_some_and(|v| v.2 + data.len() as u64 > settings.file_bytes)
+        {
+            self.close();
+        }
+        let files = self.files()?;
+        let mut total: u64 = files.iter().map(|v| v.bytes).sum::<u64>() + self.export_bytes()?;
+        for f in files {
+            let path = self.directory.join(&f.id);
+            let expired = settings.retention_days.is_some_and(|days| {
+                path.metadata()
+                    .and_then(|m| m.modified())
+                    .ok()
+                    .and_then(|t| SystemTime::now().duration_since(t).ok())
+                    .is_some_and(|v| v.as_secs() > days as u64 * 86400)
+            });
+            if !f.active
+                && !f.pinned
+                && (expired || total + data.len() as u64 > settings.total_bytes)
+            {
+                fs::remove_file(path)?;
+                total = total.saturating_sub(f.bytes);
+            }
+        }
+        if total + data.len() as u64 > settings.total_bytes {
+            return Err(error("quota_protected"));
+        }
+        if self.active.is_none() {
+            let id = format!(
+                "rlog-{:020}-{}.ndjson",
+                now(),
+                hex(&rand::random::<[u8; 8]>())
+            );
+            let f = private_file(&self.directory.join(&id))?;
+            try_exclusive(&f)?;
+            self.active = Some((id, f, 0));
+        }
+        let (_, file, size) = self.active.as_mut().unwrap();
+        file.write_all(&data)?;
+        *size += data.len() as u64;
+        Ok(())
+    }
+}
+fn valid_id(id: &str) -> bool {
+    id.starts_with("rlog-")
+        && id.ends_with(".ndjson")
+        && id.len() < 100
+        && id
+            .bytes()
+            .all(|b| b.is_ascii_alphanumeric() || b == b'-' || b == b'.')
+}
+fn visit_records(path: &Path, mut visit: impl FnMut(Event) -> io::Result<bool>) -> io::Result<()> {
+    if !fs::symlink_metadata(path)?.file_type().is_file() {
+        return Err(error("unsafe_file"));
+    }
+    let mut reader = BufReader::new(File::open(path)?);
+    loop {
+        let mut bytes = Vec::new();
+        let size = reader
+            .by_ref()
+            .take(MAX_RECORD as u64 + 1)
+            .read_until(b'\n', &mut bytes)?;
+        if size == 0 {
+            break;
+        }
+        if size > MAX_RECORD {
+            return Err(error("corrupt_record"));
+        }
+        let event: Event = serde_json::from_slice(&bytes).map_err(|_| error("corrupt_record"))?;
+        validate_event(&event)?;
+        if !visit(event)? {
+            break;
+        }
+    }
+    Ok(())
+}
+fn validate_event(e: &Event) -> io::Result<()> {
+    let is_hex = |v: &str, n: usize| v.len() == n && v.bytes().all(|b| b.is_ascii_hexdigit());
+    if !(1..=4).contains(&e.level)
+        || chrono::DateTime::parse_from_rfc3339(&e.timestamp).is_err()
+        || !is_hex(&e.recording, 32)
+        || !is_hex(&e.thread, 24)
+        || e.session.as_ref().is_some_and(|v| !is_hex(v, 24))
+        || e.endpoint.as_ref().is_some_and(|v| !is_hex(v, 24))
+        || e.transport
+            .as_ref()
+            .is_some_and(|v| !["http", "https", "ws", "wss"].contains(&v.as_str()))
+        || e.route
+            .as_ref()
+            .is_some_and(|v| !["id", "relay", "other"].contains(&v.as_str()))
+        || e.status.is_some_and(|v| !(100..=599).contains(&v))
+    {
+        return Err(error("unsafe_record"));
+    }
+    Ok(())
+}
+struct ValidatedReader {
+    reader: BufReader<File>,
+    pending: Vec<u8>,
+    offset: usize,
+}
+impl ValidatedReader {
+    fn new(path: &Path) -> io::Result<Self> {
+        if !fs::symlink_metadata(path)?.file_type().is_file() {
+            return Err(error("unsafe_file"));
+        }
+        Ok(Self {
+            reader: BufReader::new(File::open(path)?),
+            pending: Vec::new(),
+            offset: 0,
+        })
+    }
+}
+impl Read for ValidatedReader {
+    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
+        if out.is_empty() {
+            return Ok(0);
+        }
+        if self.offset == self.pending.len() {
+            let mut line = Vec::new();
+            let size = self
+                .reader
+                .by_ref()
+                .take(MAX_RECORD as u64 + 1)
+                .read_until(b'\n', &mut line)?;
+            if size == 0 {
+                return Ok(0);
+            }
+            if size > MAX_RECORD {
+                return Err(error("corrupt_record"));
+            }
+            let event: Event =
+                serde_json::from_slice(&line).map_err(|_| error("corrupt_record"))?;
+            validate_event(&event)?;
+            self.pending = serde_json::to_vec(&event)?;
+            self.pending.push(b'\n');
+            self.offset = 0;
+        }
+        let size = out.len().min(self.pending.len() - self.offset);
+        out[..size].copy_from_slice(&self.pending[self.offset..self.offset + size]);
+        self.offset += size;
+        Ok(size)
+    }
+}
+static ENGINE: OnceLock<Engine> = OnceLock::new();
+pub fn initialize(directory: PathBuf) -> io::Result<()> {
+    static INITIALIZE: Mutex<()> = Mutex::new(());
+    let _guard = INITIALIZE.lock().unwrap();
+    if ENGINE.get().is_none() {
+        let engine = Engine::start(directory)?;
+        let _ = ENGINE.set(engine);
+        if let Some(engine) = ENGINE.get() {
+            engine.capture(2, Module::App, Kind::Started, Code::None, None, None, None);
+        }
+    }
+    Ok(())
+}
+pub fn global() -> Option<&'static Engine> {
+    ENGINE.get()
+}
+pub fn legacy(record: &log::Record) {
+    if let Some(engine) = global() {
+        let target = record.target();
+        let module = if target.contains("websocket") {
+            Module::Websocket
+        } else if target.contains("tls") {
+            Module::Tls
+        } else if target.contains("rendezvous") {
+            Module::Rendezvous
+        } else if target.contains("hbbs_http") {
+            Module::Api
+        } else if target.contains("config") {
+            Module::Config
+        } else if target.contains("relay") {
+            Module::Relay
+        } else if target.contains("tcp")
+            || target.contains("udp")
+            || target.contains("socket")
+            || target.contains("proxy")
+        {
+            Module::Network
+        } else if target.contains("permission") || target.contains("privilege") {
+            Module::Permission
+        } else if target.contains("flutter") {
+            Module::Flutter
+        } else if target.contains("core_main") || target.contains("service") {
+            Module::App
+        } else if target.contains("client") {
+            Module::Session
+        } else if target.contains("audio") {
+            Module::Audio
+        } else if target.contains("video") {
+            Module::Video
+        } else if target.contains("clipboard") {
+            Module::Clipboard
+        } else if target.contains("file") {
+            Module::Transfer
+        } else {
+            Module::Other
+        };
+        let level = match record.level() {
+            log::Level::Error => 1,
+            log::Level::Warn | log::Level::Info => 2,
+            log::Level::Debug => 3,
+            log::Level::Trace => 4,
+        };
+        engine.capture(
+            level,
+            module,
+            Kind::LegacyEvent,
+            if level == 1 {
+                Code::Unknown
+            } else {
+                Code::None
+            },
+            None,
+            None,
+            None,
+        );
+    }
+}
