+                    serde_json::from_value(value["event"].clone()).map_err(|_| "invalid_event")?;
+                self.capture(
+                    event.level,
+                    event.module,
+                    event.kind,
+                    event.code,
+                    None,
+                    None,
+                    None,
+                );
+                Ok(Route::Immediate(serde_json::json!(true)))
+            }
+            "status" => Ok(Route::Immediate(
+                serde_json::json!({"status":self.status(),"settings":self.settings(),"build":self.shared.lock().unwrap().build}),
+            )),
+            "configure" => Ok(Route::Work(Command::Configure(
+                serde_json::from_value(value["settings"].clone())
+                    .map_err(|_| "invalid_settings")?,
+            ))),
+            "stop" => Ok(Route::Work(Command::Stop)),
+            "files" => Ok(Route::Work(Command::Files)),
+            "query" => Ok(Route::Work(Command::Query(
+                serde_json::from_value(value["query"].clone()).map_err(|_| "invalid_query")?,
+            ))),
+            "pin" => Ok(Route::Work(Command::Pin(
+                value["id"].as_str().ok_or("invalid_id")?.into(),
+                value["pinned"].as_bool().ok_or("invalid_pin")?,
+            ))),
+            "clear" if value["confirmed"] == true => Ok(Route::Work(Command::Clear)),
+            "export" => Ok(Route::Work(Command::Export(
+                serde_json::from_value(value["ids"].clone()).map_err(|_| "invalid_ids")?,
+            ))),
+            _ => Err("invalid_operation".into()),
+        }
+    }
+    pub fn request(&self, value: serde_json::Value) -> Result<serde_json::Value, String> {
+        match self.route(value)? {
+            Route::Immediate(value) => Ok(value),
+            Route::Work(command) => self.call(command),
+        }
+    }
+    /// Submit using existing asynchronous FFI setters. Payloads are never local options.
+    pub fn begin(&self, id: &str, value: serde_json::Value) -> Result<(), String> {
+        if id.is_empty() || id.len() > 64 || !id.bytes().all(|b| b.is_ascii_hexdigit() || b == b'-')
+        {
+            return Err("invalid_request".into());
+        }
+        let mut jobs = self.jobs.try_lock().map_err(|_| "diagnostics_busy")?;
+        jobs.retain(|_, job| job.created.elapsed() < Duration::from_secs(60));
+        if jobs.len() >= 16 || jobs.contains_key(id) {
+            return Err("diagnostics_busy".into());
+        }
+        let (sender, receiver) = mpsc::channel();
+        match self.route(value) {
+            Ok(Route::Work(command)) => self
+                .commands
+                .try_send(Work {
+                    command,
+                    reply: sender,
+                })
+                .map_err(|_| "diagnostics_busy")?,
+            Ok(Route::Immediate(value)) => {
+                let _ = sender.send(Ok(value));
+            }
+            Err(code) => {
+                let _ = sender.send(Err(code));
+            }
+        }
+        jobs.insert(
+            id.into(),
+            Job {
+                created: Instant::now(),
+                receiver,
+            },
+        );
+        Ok(())
+    }
+    /// Synchronous FFI getter only polls bounded in-memory results: no filesystem/wait.
+    pub fn poll(&self, id: &str) -> String {
+        let Ok(mut jobs) = self.jobs.try_lock() else {
+            return String::new();
+        };
+        let result = match jobs.get(id) {
+            Some(job) => match job.receiver.try_recv() {
+                Ok(value) => value,
+                Err(mpsc::TryRecvError::Empty)
+                    if job.created.elapsed() < Duration::from_secs(60) =>
+                {
+                    return String::new()
+                }
+                Err(mpsc::TryRecvError::Empty) => Err("diagnostics_timeout".into()),
+                Err(mpsc::TryRecvError::Disconnected) => Err("diagnostics_operation_failed".into()),
+            },
+            None => Err("diagnostics_busy".into()),
+        };
+        jobs.remove(id);
+        match result {
+            Ok(data) => serde_json::json!({"ok":true,"data":data}),
+            Err(code) => serde_json::json!({"ok":false,"error":code}),
+        }
+        .to_string()
+    }
