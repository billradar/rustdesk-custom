+                    .after
+                    .as_deref()
+                    .map(chrono::DateTime::parse_from_rfc3339)
+                    .transpose()
+                    .map_err(|_| error("invalid_query"))?;
+                if query.level.is_some_and(|v| !(1..=4).contains(&v)) {
+                    return Err(error("invalid_query"));
+                }
+                self.close();
+                let _lock = self.lock()?;
+                let mut rows = Vec::new();
+                let mut skip = query.offset.unwrap_or(0).min(1_000_000);
+                for f in self.files()? {
+                    if f.active {
+                        continue;
+                    }
+                    visit_records(&self.directory.join(f.id), |event| {
+                        let text = serde_json::to_string(&event)?;
+                        if after.as_ref().is_some_and(|v| {
+                            chrono::DateTime::parse_from_rfc3339(&event.timestamp)
+                                .expect("validated timestamp")
+                                < *v
+                        }) || query.level.is_some_and(|v| event.level > v)
+                            || query.module.is_some_and(|v| {
+                                std::mem::discriminant(&event.module) != std::mem::discriminant(&v)
+                            })
+                            || query.keyword.as_ref().is_some_and(|v| !text.contains(v))
+                        {
+                            return Ok(true);
+                        }
+                        if skip > 0 {
+                            skip -= 1;
+                            return Ok(true);
+                        }
+                        rows.push(event);
+                        Ok(rows.len() != MAX_QUERY)
+                    })?;
+                    if rows.len() == MAX_QUERY {
+                        break;
+                    }
+                }
+                Ok(serde_json::to_value(rows)?)
+            }
+            Command::Export(ids) => {
+                if ids.is_empty() || ids.len() > 1000 || ids.iter().any(|id| !valid_id(id)) {
+                    return Err(error("invalid_selection"));
+                }
+                self.close();
+                let config_lock = OpenOptions::new()
+                    .read(true)
+                    .write(true)
+                    .create(true)
+                    .truncate(false)
+                    .open(self.config.with_extension("lock"))?;
+                try_exclusive(&config_lock)?;
+                let _lock = self.lock()?;
+                let files = self.files()?;
+                let exports = self.config.parent().unwrap().join("exports");
+                private_dir(&exports)?;
+                let metadata = serde_json::to_vec(
+                    &serde_json::json!({"schema":1,"privacy":"typed-events-only","automatic_upload":false,"exporter_build":shared.lock().unwrap().build,"dropped_events_snapshot":shared.lock().unwrap().status.dropped,"platform":std::env::consts::OS,"architecture":std::env::consts::ARCH}),
+                )?;
+                let mut sizes = Vec::new();
+                let mut archive_size = 1024 + 512 + ((metadata.len() as u64 + 511) / 512) * 512;
+                for id in &ids {
+                    if !files.iter().any(|f| f.id == *id && !f.active) {
+                        return Err(error("active_or_missing_file"));
+                    }
+                    let mut size = 0;
+                    visit_records(&self.directory.join(id), |e| {
+                        size += serde_json::to_vec(&e)?.len() as u64 + 1;
+                        Ok(true)
+                    })?;
+                    sizes.push(size);
+                    archive_size += 512 + ((size + 511) / 512) * 512;
+                }
+                // Temporary archives are part of the configured storage cap. Never exceed
+                // it to export; the user can select fewer files, clean up or raise the cap.
+                self.clean_exports()?;
+                let used: u64 = files.iter().map(|f| f.bytes).sum::<u64>() + self.export_bytes()?;
+                let limit = shared.lock().unwrap().settings.total_bytes;
+                if used.saturating_add(archive_size) > limit {
+                    return Err(error("export_requires_storage_budget"));
+                }
+                if fs2::available_space(&exports)? < archive_size.saturating_add(MB) {
+                    return Err(error("export_disk_space"));
+                }
+                let path = exports.join(format!(
+                    "diagnostics-{}.tar",
+                    hex(&rand::random::<[u8; 16]>())
