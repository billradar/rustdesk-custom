+                    &format!("{}:{:?}", std::process::id(), std::thread::current().id()),
+                ),
+                kind,
+                recording: s.recording.clone(),
+                session: session.map(|v| pseudonym(&s.key, v)),
+                code,
+                status,
+                endpoint: endpoint.map(|v| pseudonym(&s.key, v)),
+                transport: parsed.as_ref().map(|v| v.0.clone()),
+                port: parsed.as_ref().map(|v| v.1),
+                route: parsed.map(|v| v.2),
