+        if self.config.exists() {
+            let backup = self.config.with_extension("backup");
+            if backup.exists() {
+                fs::remove_file(&backup)?;
+            }
+            fs::rename(&self.config, backup)?;
+        }
+        fs::rename(temp, &self.config)?;
+        self.config_modified = fs::metadata(&self.config).and_then(|m| m.modified()).ok();
+        Ok(saved_settings.enabled)
+    }
+    fn elapsed(&self) -> u64 {
+        self.started
+            .map(|start| {
+                let elapsed = start.elapsed();
+                let elapsed = self
+                    .deadline
+                    .map(|end| elapsed.min(end.saturating_duration_since(start)))
+                    .unwrap_or(elapsed);
+                self.elapsed_at_start.saturating_add(elapsed.as_secs())
+            })
+            .unwrap_or(0)
+    }
+    fn configure(
+        &mut self,
+        mut settings: Settings,
+        explicit_start: bool,
+        shared: &Mutex<Shared>,
+    ) -> io::Result<serde_json::Value> {
+        settings.validate()?;
+        let current = shared.lock().unwrap().settings.clone();
+        let expired = current.active_until_utc.is_some_and(|v| now() >= v)
+            || self.deadline.is_some_and(|v| Instant::now() >= v);
+        settings.enabled = explicit_start || (current.enabled && !expired);
+        settings.active_until_utc = None;
+        settings.active_started_utc = None;
+        if explicit_start {
+            settings.active_until_utc = settings.end_utc;
+            let start = settings.start_utc.unwrap_or_else(now).max(now());
+            settings.active_started_utc = Some(start);
+            if let Some(seconds) = settings.duration_seconds {
+                let end = start.saturating_add(seconds as i64);
+                settings.active_until_utc = Some(settings.end_utc.map_or(end, |v| v.min(end)));
+            }
+            if settings.active_until_utc.is_some_and(|v| v <= start) {
+                return Err(error("invalid_schedule"));
+            }
+        }
+        if !explicit_start && settings.enabled {
+            settings.active_started_utc = current.active_started_utc;
+            settings.active_until_utc = current.active_until_utc;
+        }
+        let directory = settings
+            .directory
+            .clone()
+            .unwrap_or_else(|| self.config.parent().unwrap().join("records"));
+        private_dir(&directory)?;
+        let probe = directory.join(format!(".probe-{}", hex(&rand::random::<[u8; 8]>())));
+        drop(private_file(&probe)?);
+        fs::remove_file(probe)?;
+        let (key, recording) = if explicit_start {
+            (rand::random(), hex(&rand::random::<[u8; 16]>()))
+        } else {
+            let s = shared.lock().unwrap();
+            (s.key, s.recording.clone())
+        };
+        settings.enabled = self.persist(&settings, &key, &recording, explicit_start)?;
+        let stopped_elapsed = self.elapsed();
+        self.close();
+        self.directory = directory;
+        if explicit_start || !settings.enabled {
+            self.started = None;
+            self.deadline = None;
+        }
+        self.last_tick = None;
+        let mut s = shared.lock().unwrap();
+        if explicit_start {
+            s.status.elapsed_seconds = 0;
+        } else if !settings.enabled {
+            s.status.elapsed_seconds = stopped_elapsed;
+        }
+        s.settings = settings;
+        s.key = key;
+        s.recording = recording;
+        s.status.error = None;
+        Ok(serde_json::json!(true))
+    }
+    fn command(
+        &mut self,
+        command: Command,
+        shared: &Mutex<Shared>,
