+//! Optional local diagnostics. Arbitrary log arguments NEVER enter this store.
+use fs2::FileExt;
+use hmac::{Hmac, Mac};
+use serde::{Deserialize, Serialize};
+use sha2::Sha256;
+use std::{
+    collections::HashMap,
+    fs::{self, File, OpenOptions},
+    io::{self, BufRead, BufReader, Read, Write},
+    path::{Path, PathBuf},
+    sync::{
+        atomic::{AtomicU64, Ordering},
+        mpsc::{self, SyncSender},
+        Arc, Mutex, OnceLock,
+    },
+    time::{Duration, Instant, SystemTime, UNIX_EPOCH},
+};
+const MB: u64 = 1024 * 1024;
+const MAX_RECORD: usize = 4096;
+const MAX_QUERY: usize = 200;
+fn now() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_secs() as i64
+}
+fn error(code: &'static str) -> io::Error {
+    io::Error::other(code)
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Settings {
+    pub enabled: bool,
+    pub level: u8,
+    pub duration_seconds: Option<u64>,
+    pub start_utc: Option<i64>,
+    pub end_utc: Option<i64>,
+    #[serde(default)]
+    pub active_until_utc: Option<i64>,
+    #[serde(default)]
+    pub active_started_utc: Option<i64>,
+    pub file_bytes: u64,
+    pub total_bytes: u64,
+    pub retention_days: Option<u32>,
+    pub directory: Option<PathBuf>,
+}
+impl Default for Settings {
+    fn default() -> Self {
+        Self {
+            enabled: false,
+            level: 2,
+            duration_seconds: Some(3600),
+            start_utc: None,
+            end_utc: None,
+            active_until_utc: None,
+            active_started_utc: None,
+            file_bytes: 20 * MB,
+            total_bytes: 100 * MB,
+            retention_days: Some(7),
+            directory: None,
+        }
+    }
+}
+impl Settings {
+    pub fn validate(&self) -> io::Result<()> {
+        if self
+            .directory
+            .as_ref()
+            .is_some_and(|v| !v.is_absolute() || v.as_os_str().len() > 4096)
+        {
+            return Err(error("invalid_settings"));
+        }
+        if [
+            self.start_utc,
+            self.end_utc,
+            self.active_until_utc,
+            self.active_started_utc,
+        ]
+        .into_iter()
+        .flatten()
+        .any(|v| v < 0 || v > now() + 2 * 366 * 86400)
+        {
+            return Err(error("invalid_schedule"));
+        }
+        if !(1..=4).contains(&self.level)
+            || self.file_bytes < MB
+            || self.file_bytes > 5 * 1024 * MB
+            || self.total_bytes < self.file_bytes
+            || self.total_bytes > 50 * 1024 * MB
+            || self
+                .duration_seconds
+                .is_some_and(|v| v == 0 || v > 366 * 86400)
+            || self.retention_days.is_some_and(|v| v == 0 || v > 3650)
+            || matches!((self.start_utc,self.end_utc),(Some(a),Some(b)) if a>=b)
+        {
+            return Err(error("invalid_settings"));
+        }
+        Ok(())
+    }
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Module {
+    App,
+    Config,
+    Network,
+    Tls,
+    Websocket,
+    Api,
+    Rendezvous,
+    Relay,
+    Session,
+    Audio,
+    Video,
+    Transfer,
+    Clipboard,
+    Flutter,
+    Native,
+    Permission,
+    Other,
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Kind {
+    Started,
+    Stopped,
+    Changed,
+    Attempt,
+    Connected,
+    Failed,
+    Disconnected,
+    Upgrade,
+    LegacyEvent,
+    Overflow,
+}
+#[derive(Clone, Copy, Debug, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum Code {
+    None,
+    Io,
+    Timeout,
+    Dns,
+    Tcp,
+    Certificate,
+    Tls,
+    Protocol,
+    Http,
+    Cancelled,
+    Permission,
+    Storage,
+    Unknown,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Event {
+    timestamp: String,
+    level: u8,
+    module: Module,
+    process: u32,
+    thread: String,
+    kind: Kind,
+    recording: String,
+    session: Option<String>,
+    code: Code,
+    status: Option<u16>,
+    endpoint: Option<String>,
+    transport: Option<String>,
+    port: Option<u16>,
+    route: Option<String>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Status {
+    pub state: String,
+    pub error: Option<String>,
+    pub elapsed_seconds: u64,
+    pub remaining_seconds: Option<u64>,
+    pub current_bytes: u64,
+    pub total_bytes: u64,
+    pub files: usize,
+    pub dropped: u64,
+    pub export_bytes: u64,
+    pub directory: PathBuf,
+}
+impl Default for Status {
+    fn default() -> Self {
+        Self {
+            state: "off".into(),
+            error: None,
+            elapsed_seconds: 0,
+            remaining_seconds: None,
+            current_bytes: 0,
+            total_bytes: 0,
+            files: 0,
+            dropped: 0,
+            export_bytes: 0,
+            directory: PathBuf::new(),
+        }
+    }
+}
+#[derive(Clone, Serialize)]
+pub struct LogFile {
+    pub id: String,
+    pub bytes: u64,
+    pub pinned: bool,
+    pub active: bool,
+}
+#[derive(Default, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Query {
+    pub after: Option<String>,
+    pub level: Option<u8>,
+    pub module: Option<Module>,
+    pub keyword: Option<String>,
+    pub offset: Option<usize>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Persisted {
+    settings: Settings,
+    key: [u8; 32],
+    recording: String,
+}
+impl Persisted {
+    fn new(settings: Settings) -> Self {
+        Self {
+            settings,
+            key: rand::random(),
+            recording: hex(&rand::random::<[u8; 16]>()),
+        }
+    }
+    fn decode(bytes: &[u8]) -> io::Result<Self> {
+        let saved: Self =
+            serde_json::from_slice(bytes).map_err(|_| error("invalid_saved_settings"))?;
+        saved.settings.validate()?;
+        if saved.recording.len() != 32 || !saved.recording.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return Err(error("invalid_saved_recording"));
+        }
+        Ok(saved)
+    }
+}
+struct Shared {
+    settings: Settings,
+    status: Status,
+    key: [u8; 32],
+    recording: String,
+    build: serde_json::Value,
+}
+enum Command {
+    Configure(Settings),
+    Stop,
+    Pin(String, bool),
+    Clear,
+    Query(Query),
+    Export(Vec<String>),
+    Files,
+}
+struct Work {
+    command: Command,
+    reply: mpsc::Sender<Result<serde_json::Value, String>>,
+}
+enum Route {
+    Immediate(serde_json::Value),
+    Work(Command),
+}
