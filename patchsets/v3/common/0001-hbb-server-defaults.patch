+/// All app-managed legacy file output is metadata only. Never format record.args().
+pub fn diagnostic_format(
+    w: &mut dyn std::io::Write,
+    _now: &mut flexi_logger::DeferredNow,
+    record: &log::Record,
+) -> std::io::Result<()> {
+    if record.level() == log::Level::Error {
+        write!(
+            w,
+            "{} ERROR diagnostic event (details omitted)",
+            chrono::Utc::now().to_rfc3339()
+        )
+    } else {
+        Ok(())
+    }
+}
+
+#[cfg(not(debug_assertions))]
+struct DiagnosticWriter(flexi_logger::writers::FileLogWriter);
+#[cfg(not(debug_assertions))]
+impl flexi_logger::writers::LogWriter for DiagnosticWriter {
+    fn write(
+        &self,
+        now: &mut flexi_logger::DeferredNow,
+        record: &log::Record,
+    ) -> std::io::Result<()> {
+        radar_diagnostics::legacy(record);
+        if record.level() == log::Level::Error {
+            flexi_logger::writers::LogWriter::write(&self.0, now, record)
+        } else {
+            Ok(())
+        }
+    }
+    fn flush(&self) -> std::io::Result<()> {
+        flexi_logger::writers::LogWriter::flush(&self.0)
+    }
+}
