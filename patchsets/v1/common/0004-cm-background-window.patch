@@ -0,0 +1,20 @@
+/// CM visibility is independent of authentication and saved hide preferences.
+class CmWindowPolicy {
+  bool ready = false;
+  bool manualRequested = false;
+  bool visible = false;
+
+  void initialize() {
+    ready = true;
+  }
+
+  bool requestShow({bool manual = false}) {
+    if (manual) manualRequested = true;
+    return ready && manual;
+  }
+
+  void hide() {
+    manualRequested = false;
+    visible = false;
+  }
+}
